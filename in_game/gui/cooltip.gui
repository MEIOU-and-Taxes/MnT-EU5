		blockoverride "tooltip_content" {
			TooltipTextBlock = {
				blockoverride "text" {
					text = "game_concept_trait_upper_desc"
				}
			}

			TooltipListBase = {
				TooltipManualTableField = {
					text_single = {
						layoutpolicy_horizontal = expanding
						autoresize = no
						text = "[ruler_traits|e]"
					}
					text_single = {
						autoresize = yes
						text = "[GetDataModelSize(GetTraitTypeList('ruler'))|L]"

						tooltipwidget = {
							ContextualTooltipType = {
