container = {
	alwaystransparent = no
	name = "CharacterDeathReasonTooltip"
	ContextualTooltipType = {
		blockoverride "title_text" {
			text = "BREAKDOWN_REASONS_DEATH_TITLE"
		}
		blockoverride "title_icon" {
			icon = {
				texture = "gfx/interface/icons/character_roles/death.dds"
				using = tooltip_title_icon_size
			}
		}
		blockoverride "concept_link" {
			text = [character|E]
		}
		blockoverride "tooltip_content" {
			TooltipTextBlock = {
				blockoverride "text" {
					text = "[Character.GetDeathReason]"
				}
			}
		}
	}
}

container = {
	alwaystransparent = no
	name = "DecisionTooltip"
	# Mirrors the lateral view's button tooltip (game/in_game/gui/decisions_lateralview.gui).
	# GetDecisionTooltipCountry prefers the player and falls back to the multiplayer lobby's
	# selected country, so the requirements + options resolve everywhere the tooltip can fire.
	ContextualTooltipType = {
		blockoverride "title_text" {
			text = "[Decision.GetNameWithNoTooltip]"
		}
		blockoverride "title_icon" {
			icon = {
				texture = "gfx/interface/icons/flat_icons/action.dds"
				using = tooltip_title_icon_size
			}
		}
		blockoverride "tooltip_content" {


			TooltipDebugTextBlock = {
				blockoverride "text" {
					debug_text = "[Decision.GetDebugText]"
				}
			}

			TooltipScrolledRequirementsList = {
				textcontext = "[Decision.GetAllowDescriptionForCountry(GetDecisionTooltipCountry)]"
				blockoverride "block_title" {
					text = "[SelectLocalization(Decision.IsAllowedForCountry(GetDecisionTooltipCountry), 'REQUIREMENT_ARE_MET', 'REQUIREMENT_ARE_NOT_MET')]"
					background = {
						visible = "[Decision.IsAllowedForCountry(GetDecisionTooltipCountry)]"
						using = color_mid_light_green_texture
						alpha = 0.9
					}
					background = {
						visible = "[Not(Decision.IsAllowedForCountry(GetDecisionTooltipCountry))]"
						using = color_mid_red_texture
						alpha = 0.7
					}
				}
				blockoverride "block_scrollarea" { maximumsize = { -1 450 }}
			}

			TooltipScrolledGroupedRowList = {
				textcontext = "[Decision.GetOutcomesListForCountry(GetDecisionTooltipCountry)]"
				tooltipmeta = {
					texture = "[GetConceptTexture('event_option')]"
					game_concept = "[event_option|e]"
				}
				blockoverride "block_title" {
					text = "DECISION_TT_OUTCOMES"
				}
				blockoverride "block_scrollarea" { maximumsize = { -1 300 }}
			}

			TooltipFlavorTextBlock = {
				blockoverride "text" {
					text = "[Decision.GetDesc]"
				}
			}
		}
	}
}

