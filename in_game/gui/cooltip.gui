							blockoverride "field_left" { expand = {} }
							blockoverride "field_text" {
								datacontext = "[LocationUpKeepBuildingItem]"
								raw_text = "#R -[LocationUpKeepBuildingItem.GetUpkeep|L2]#!@expense!"
