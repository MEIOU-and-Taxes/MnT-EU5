# Timeline mapmode cooltip — shows the historical owner of the hovered location at the
# playback panel's current cursor date, along with the date itself. Pulls owner via
# `GetTimelinePlaybackPanel.GetOwnerAtCursorForLocation(Location.Self)` from the panel's
# cached world snapshot.
container = {
	alwaystransparent = no
	name = "LocationMapTooltip_timeline_ownership"
	datacontext = "[GetTimelinePlaybackPanel]"
	ContextualTooltipType = {
		blockoverride "title_icon_texture" {
			texture = "[GetConceptTexture('location')]"
		}
		blockoverride "title_text" {
			text = "[Location.GetName]"
		}
		blockoverride "concept_link" {
			text = "[location|e]"
		}
		blockoverride "tooltip_content" {
			TooltipListBase = {
				TooltipManualTableField = {
					text_single = {
						layoutpolicy_horizontal = expanding
						default_format = "#low"
						raw_text = "[TimelinePlaybackPanel.GetCursorDateString]"
					}
				}

				TooltipManualTableField = {
					visible = "[Not(StringIsEmpty(TimelinePlaybackPanel.GetHistoricalOwnerNameForLocation(Location.Self)))]"

					text_single = {
						text = "LOCATION_OWNER_TT"
					}

					text_single = {
						layoutpolicy_horizontal = expanding
						default_format = "#yellow_titles"
						raw_text = "[TimelinePlaybackPanel.GetHistoricalOwnerNameForLocation(Location.Self)]"
					}
				}
			}

			TooltipDebugStringPairList = {
				textcontext = "[TimelinePlaybackPanel.GetTimelineDebugTextForLocation(Location.Self)]"
			}
		}
	}
	blockoverride "bg_tooltip_alpha" { alpha = @map_tooltip_alpha }
}

