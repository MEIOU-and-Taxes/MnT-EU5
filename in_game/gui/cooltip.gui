						texture = "[ModifierSourceWrap.GetModifierType.GetIcon]"
						tintcolor = "[ExtraTooltipInfo.GetTintColor]"
					}
				}
			}

			TooltipLockProgress = {}
		}

		blockoverride "title_text" {
			text = "[ModifierSourceWrap.GetModifierType.GetNameWithNoTooltip]"
		}

		blockoverride "concept_link" {
			text = "[modifier|e]"
		}

		blockoverride "tooltip_content" {
			TooltipStringPairList = {
				visible = "[Not(StringIsEmpty(ModifierSourceWrap.GetBreakdown))]"
				textcontext = "[ModifierSourceWrap.GetBreakdown]"
			}

			TooltipStringPairList = {
				visible = "[Not(StringIsEmpty(ModifierSourceWrap.GetScalingBreakdown))]"
				textcontext = "[ModifierSourceWrap.GetScalingBreakdown]"
			}

			TooltipTextBlock = {
				visible = "[StringIsEmpty(ModifierSourceWrap.GetScalingBreakdown)]"
				blockoverride "text" {
					text = "[ModifierSourceWrap.GetModifierType.GetFlavorDesc]"
				}
			}
		}
	}
}

