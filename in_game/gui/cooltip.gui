container = {
	alwaystransparent = no
	name = "CountryMapTooltip_rebels"
	ContextualTooltipType = {
		blockoverride "title_icon" {
			icon = {
				using = tooltip_title_icon_size
				texture = "gfx/interface/icons/rebels/fist.dds"
			}
		}
		blockoverride "title_text" {
			text = "REBEL_MAPMODE_COUNTRY_TITLE"
		}
		blockoverride "tooltip_content" {
			TooltipScrolledStringPairList = {
				visible = "[Location.HasMapmodeSpecificTooltip]"
				layoutpolicy_horizontal = expanding
				blockoverride "block_scrollarea" {
					maximumsize = { -1 400 }
				}
				textcontext = "[Location.GetMapmodeSpecificTooltip]"
			}
		}
	}
	blockoverride "bg_tooltip_alpha" { alpha = @map_tooltip_alpha }
}

