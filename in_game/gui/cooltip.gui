container = {
	alwaystransparent = no
	name = "SimpleCustomTagTooltip"
	ContextualTooltipType = {
		blockoverride "title_icon" {
			icon = {
				visible = "[SimpleCustomTagTooltipWrapper.HasIcon]"
				using = tooltip_title_icon_size
				texture = "[SimpleCustomTagTooltipWrapper.GetIcon]"
			}
		}

		blockoverride "title_text" {
			visible = "[Not(StringIsEmpty(SimpleCustomTagTooltipWrapper.GetTitle))]"
			text = "[SimpleCustomTagTooltipWrapper.GetTitle]"
		}

		blockoverride "concept_link" {
			visible = "[Not(StringIsEmpty(SimpleCustomTagTooltipWrapper.GetConcept))]"
			text = "[SimpleCustomTagTooltipWrapper.GetConcept]"
		}

		blockoverride "tooltip_content" {
			TooltipTextBlock = {
				visible = "[Not(StringIsEmpty(SimpleCustomTagTooltipWrapper.GetBody))]"
				blockoverride "text" {
					text = "[SimpleCustomTagTooltipWrapper.GetBody]"
				}
			}
			TooltipStringPairList = {
				visible = "[Not(StringIsEmpty(SimpleCustomTagTooltipWrapper.GetList))]"
				textcontext = "[SimpleCustomTagTooltipWrapper.GetList]"
			}
			TooltipFlavorTextBlock = {
				visible = "[Not(StringIsEmpty(SimpleCustomTagTooltipWrapper.GetFlavor))]"
				blockoverride "text" {
					text = "[SimpleCustomTagTooltipWrapper.GetFlavor]"
				}
			}
		}
	}
}

