							blockoverride "field_left" {
								datacontext = "[LocationUpKeepBuildingItem]"
								icon = {
									size = { 24 24 }
									texture = "[GetBuildingIcon(LocationUpKeepBuildingItem.GetBuilding.GetType)]"
								}
