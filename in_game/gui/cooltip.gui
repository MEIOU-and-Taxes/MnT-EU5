				blockoverride "title_icon" {
					icon = {
						using = tooltip_concept_title_icon_size
						texture = "[ModifierType.GetIcon]"
						tintcolor = "[ExtraTooltipInfo.GetTintColor]"

						glow = {
							name = "drop_shadow"
							glow_radius = 3
							color = {0.0 0.0 0.0 1.0}
							alpha = 0.3
						}
					}
				}

				blockoverride "title_text" {
					text = "[ModifierType.GetNameWithNoTooltip]"
				}
			}

			TooltipLockProgress = {}
		}

		blockoverride "concept_link" {
			text = "[modifier|e]"
		}

		blockoverride "tooltip_content" {
			TooltipDebugTextBlock = {
				blockoverride "text" {
					debug_text = "[ModifierType.GetDebugText]"
				}
			}
			TooltipTextBlock = {
				blockoverride "text" {
					text = "[ModifierType.GetFlavorDesc]"
				}
			}
		}
	}
}

container = {
