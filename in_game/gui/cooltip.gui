container = {
	alwaystransparent = no
	name = "CountryMapTooltip_ai_personality_mapmode"
	container = {
		visible = "[And(Country.IsValid, Not(Country.HasHumanController))]"
		datacontext = "[Country.GetAiPersonality]"
		using = AiPersonality_tooltip
	}
	container = {
		visible = "[And(Country.IsValid, Country.HasHumanController)]"
		ContextualTooltipType = {
			blockoverride "concept_link" {
				text = "[country_personality|e]"
			}

			blockoverride "title_text" {
				text = "[Country.GetPersonalityMapmodeTitle]"
			}

			blockoverride "title_icon" {
				icon = {
					texture = "gfx/interface/icons/map_modes/ai_personalities.dds"
					using = tooltip_title_icon_size
				}
			}

			blockoverride "tooltip_content" {
				TooltipFlavorTextBlock = {
					blockoverride "text" {
						text = "[Country.GetPersonalityMapmodeTooltip]"
					}
				}
			}
		}
	}
	blockoverride "bg_tooltip_alpha" { alpha = @map_tooltip_alpha }
}

container = {
	alwaystransparent = no
	name = "CountryMapTooltip_ai_disposition_mapmode"
	container = {
		visible = "[And(Country.IsValid, Not(Country.IsLocalPlayer))]"
		using = AiDisposition_tooltip
		# 4B: title shows the hovered country's disposition toward the perspective country
		# (the selected country, or the player when nothing is selected).
		blockoverride "title_text" {
			text = "[Select_CString(IsPlayerValid, Country.GetDispositionTowardMapPerspective, Localize('ai_disposition_mapmode'))]"
		}
		# The detailed second-person breakdown only makes sense from the player's own perspective.
		# When reading a third party's stances (a foreign country is selected), show the label alone.
		blockoverride "tooltip_content" {
			TooltipFlavorTextBlock = {
				visible = "[Not(IsPlayerValid)]"
				blockoverride "text" {
					text = "AI_DISPOSITION_NO_PLAYER_COUNTRY"
				}
			}
			TooltipFlavorTextBlock = {
				visible = "[And(IsPlayerValid, IsDispositionMapPerspectivePlayer)]"
				blockoverride "text" {
					text = "[Country.GetDispositionToPlayerDesc]"
				}
			}
			TooltipScrolledStringPairList = {
				visible = "[And3(IsPlayerValid, IsDispositionMapPerspectivePlayer, Not(StringIsEmpty(Country.GetDispositionToPlayerBreakdown)))]"
				textcontext = "[Country.GetDispositionToPlayerBreakdown]"
			}
			TooltipRowList = {
				visible = "[And3(IsPlayerValid, IsDispositionMapPerspectivePlayer, Not(StringIsEmpty(Country.GetDispositionToPlayerExpect)))]"
				textcontext = "[Country.GetDispositionToPlayerExpect]"
			}
			TooltipRowList = {
				visible = "[And3(IsPlayerValid, IsDispositionMapPerspectivePlayer, Not(StringIsEmpty(Country.GetObjectivesDisplayText)))]"
				textcontext = "[Country.GetObjectivesDisplayText]"
			}
			TooltipFlavorTextBlock = {
				visible = "[And(IsPlayerValid, Not(IsDispositionMapPerspectivePlayer))]"
				blockoverride "text" {
					text = "AI_DISPOSITION_MAP_STALENESS_NOTE"
				}
			}
		}
	}
	blockoverride "bg_tooltip_alpha" { alpha = @map_tooltip_alpha }
}

