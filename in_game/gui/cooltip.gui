			datacontext = "[BuildModeGetBuildingType]"
			using = construct_building_in_location_tt

			blockoverride "construct_building_in_location_tt_extra"{
				TooltipTextBlock = { #NOT FILTERED LOCATION
					visible = "[BuildModeHasUnfilteredItem(Location.Self)]"
					textcontext = "NOT_FILTERED_BUILDING"

					blockoverride "textblock_background_tint"  {
						modify_texture = {
							using = color_white_texture
						}
					}
				}
			}
		}
	}

	blockoverride "bg_tooltip_alpha" { alpha = @map_tooltip_alpha }
}

