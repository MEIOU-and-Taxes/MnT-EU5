container = {
	alwaystransparent = no
	name = "CountryMapTooltip_country_truce"

	container = {
		visible = "[StringIsEmpty(GetSelectedCountryOrByLocation.GetTruceToolTip(Country.Self))]"
		using = CountryTooltip
	}

	container = {
		visible = "[Not(StringIsEmpty(GetSelectedCountryOrByLocation.GetTruceToolTip(Country.Self)))]"

		ContextualTooltipType = {
			blockoverride "title_icon_texture" { texture = "gfx/interface/icons/diplomatic_status/truce.dds" }
			blockoverride "title_text" { text = "TRUCE_WITH_COUNTRY_TITLE" }
			blockoverride "concept_link" { text = "[truce|E]" }
			blockoverride "tooltip_content" {
				TooltipTextBlock = {
					blockoverride "text" {
						text = "[GetSelectedCountryOrByLocation.GetTruceToolTip(Country.Self)]"
					}
				}
			}
		}
	}

	blockoverride "bg_tooltip_alpha" { alpha = @map_tooltip_alpha }
}

