# M&T: this tooltip is loaded by filename; preserve all other EU5 1.4 roots.
container = {
	alwaystransparent = no
	name = "StaticModifierTooltip"
	ContextualTooltipType = {

		blockoverride "title_icon" {
			icon = {
				using = tooltip_title_icon_size
				texture = "[StaticModifier.GetIcon]"

				glow = {
					name = "drop_shadow"
					glow_radius = 3
					color = {0.0 0.0 0.0 1.0}
					alpha = 0.3
				}
			}
		}

		blockoverride "title_text" {
			text = "[StaticModifier.GetNameWithNoTooltip]"
		}

		blockoverride "concept_link" {
			text = "[modifier|e]"
		}

		blockoverride "tooltip_content" {
			TooltipStringPairList = {
				visible = "[Not(EqualTo_string(StaticModifier.GetNameWithNoTooltip, Localize('STATIC_MODIFIER_NAME_mnt_credit_interest_market_price')))]"
				textcontext = "[StaticModifier.GetDesc]"
			}

			vbox = {
				visible = "[EqualTo_string(StaticModifier.GetNameWithNoTooltip, Localize('STATIC_MODIFIER_NAME_mnt_credit_interest_market_price'))]"
				layoutpolicy_horizontal = expanding
				spacing = 10
				TooltipTextBlock = {
					blockoverride "text" { text = "mnt_credit_interest_intro" }
				}
				TooltipListBase = {
					blockoverride "block_title" {
						visible = yes
						text = "mnt_credit_interest_market_title"
					}
					TooltipTableField = {
						blockoverride "row_size" {
							minimumsize = { -1 56 }
							maximumsize = { -1 56 }
						}
						blockoverride "field_content" {
							margin = { 10 0 }
							spacing = 8
							icon = {
								size = { 28 28 }
								texture = "gfx/interface/icons/trade_goods/icon_goods_credit.dds"
								tooltip = "[ShowGoodsName('credit')]"
							}
							vbox = {
								size = { 100 50 }
								layoutpolicy_horizontal = fixed
								text_single = {
									size = { 100 22 }
									layoutpolicy_horizontal = fixed
									align = center|nobaseline
									using = Font_Size_Small
									text = "mnt_credit_interest_balance"
								}
								hbox = {
									spacing = 4
									text_single = {
										size = { 76 24 }
										layoutpolicy_horizontal = fixed
										align = right|nobaseline
										text = "[Subtract_CFixedPoint(GetPlayer.GetCapital.GetMarket.MakeScope.ScriptValue('mnt_credit_tooltip_market_supply'), GetPlayer.GetCapital.GetMarket.MakeScope.ScriptValue('mnt_credit_tooltip_market_demand'))|+=2]"
									}
									icon = {
										size = { 20 20 }
										texture = "gfx/interface/icons/flat_icons/trade_market/goods_balance.dds"
									}
								}
							}
							vbox = {
								size = { 100 50 }
								layoutpolicy_horizontal = fixed
								text_single = {
									size = { 100 22 }
									layoutpolicy_horizontal = fixed
									align = center|nobaseline
									using = Font_Size_Small
									text = "mnt_credit_interest_supply"
								}
								hbox = {
									spacing = 4
									text_single = {
										size = { 76 24 }
										layoutpolicy_horizontal = fixed
										align = right|nobaseline
										text = "[GetPlayer.GetCapital.GetMarket.MakeScope.ScriptValue('mnt_credit_tooltip_market_supply')|2]"
									}
									icon = {
										size = { 20 20 }
										texture = "gfx/interface/icons/flat_icons/trade_market/supply.dds"
									}
								}
							}
							vbox = {
								size = { 100 50 }
								layoutpolicy_horizontal = fixed
								text_single = {
									size = { 100 22 }
									layoutpolicy_horizontal = fixed
									align = center|nobaseline
									using = Font_Size_Small
									text = "mnt_credit_interest_demand"
								}
								hbox = {
									spacing = 4
									text_single = {
										size = { 76 24 }
										layoutpolicy_horizontal = fixed
										align = right|nobaseline
										text = "[GetPlayer.GetCapital.GetMarket.MakeScope.ScriptValue('mnt_credit_tooltip_market_demand')|2]"
									}
									icon = {
										size = { 20 20 }
										texture = "gfx/interface/icons/flat_icons/trade_market/demand.dds"
									}
								}
							}
							vbox = {
								size = { 100 50 }
								layoutpolicy_horizontal = fixed
								text_single = {
									size = { 100 22 }
									layoutpolicy_horizontal = fixed
									align = center|nobaseline
									using = Font_Size_Small
									text = "mnt_credit_interest_price"
								}
								text_single = {
									size = { 100 24 }
									layoutpolicy_horizontal = fixed
									align = center|nobaseline
									raw_text = "[GetPlayer.GetCapital.GetMarket.MakeScope.ScriptValue('mnt_credit_tooltip_market_price')|2]@gold!"
								}
							}
						}
					}
				}
				TooltipTextBlock = {
					blockoverride "text" { text = "mnt_credit_interest_formula" }
				}
			}
			TooltipFlavorTextBlock = {
				visible = "[And(StaticModifier.HasFlavorText, Not(EqualTo_string(StaticModifier.GetNameWithNoTooltip, Localize('STATIC_MODIFIER_NAME_mnt_credit_interest_market_price'))))]"
				blockoverride "text" {
					text = "[StaticModifier.GetFlavorDesc]"
				}
			}
		}
	}
}

