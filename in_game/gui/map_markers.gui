template unit_marker_item_unit_strength {
	layoutpolicy_horizontal = expanding

	onmousehierarchyenter = "[UnitMarkerItem.OnHover]"
	onmousehierarchyleave = "[UnitMarkerItem.OnLeave]"

	# block "unit_strength_size" {
		size = { -1 @unit_marker_frame_height }
	# }

	background = {
		using = bg_map_marker_shadow_texture
		margin_bottom = 15
		blend_mode = multiply
		alpha = 0.5
	}
	background = {
		using = bg_map_marker_shadow_texture
		margin = {5 0}
		margin_bottom = 15
		blend_mode = multiply
		alpha = 0.5
		visible = "[UnitMarkerItem.IsSelectedOrHighlighted]"
	}

	background = {
		using = marker_unit_side_color
		visible ="[Unit.IsArmy]"
		using = bg_army_unit_map_texture
		spriteBorder = { 20 0 }
		margin_left = -11
		margin_right = -3
		margin_top = -2
		margin_bottom = -2

		modify_texture = {
			using = overlay_striped_texture
			blend_mode = overlay
			alpha = 0.2
		}

		modify_texture = {
			using = color_progress_blue_texture
			alpha = 0.1
			visible = "[UnitMarkerItem.IsSelectedOrHighlighted]"
		}
	}

	background = {
		using = marker_unit_side_color
		visible ="[Not(Unit.IsArmy)]"
		using = bg_navy_unit_map_texture
		spriteBorder = { 20 0 }
		margin_left = -3
		margin_right = -8
		margin_top = -2

		modify_texture = {
			using = overlay_striped_texture
			blend_mode = overlay
			alpha = 0.2
		}

		modify_texture = {
			using = color_progress_blue_texture
			alpha = 0.1
			visible = "[UnitMarkerItem.IsSelectedOrHighlighted]"
		}
	}

	block "item_unit_text_object" {
		text_single = {
			size = { 100% 100% }
			autoresize = no
			align = right|nobaseline
			margin_left = @[unit_marker_morale_progressbar_size * 0.6]
			margin_right = @unit_marker_frame_text_margin
			text = "[UnitMarkerItem.GetLabel]"
			snap_to_pixels = "[IsLowestIconScalingQuality]"
		}
	}

	# ARMY NAVY BUTTON OURS
	widget = {
		size = {100% 100%}

		unit_marker_army_button = {
			size = { 100% 100% }
			name = "unit_marker_for_army"
			visible = "[And(UnitMarkerItem.IsPlayer, Unit.IsArmy)]"

			tagtooltip_enabled = yes
			tooltip = "[UnitMarkerItem.GetTooltip]"
			contextmenu_widget = {
				UnitMarkerContextMenu = {}
			}

			action_tooltip = {
				click_type = left
				click_mode = single

				visible = "[UnitMarkerItem.IsPlayer]"
				title = "UNIT_CLICK_TOOLTIP_LEFT_CLICK"
				on_action = "[UnitMarkerItem.OnClick]"
			}

			action_tooltip = {
				click_type = right
				click_mode = single

				visible = "[And(And(And(And(Not(UnitMarkerItem.RightClickToJoin),Not(UnitMarkerItem.RightClickToMerge)),Not(UnitMarkerItem.RightClickToEmbark)),Not(UnitMarkerItem.RightClickToChase)), UnitMarkerItem.IsPlayer)]"
				cursor = "unit_menu"
				title = "UNIT_CLICK_TOOLTIP_RIGHT_CLICK"
				on_action = "[PdxGuiWidget.ToggleContextMenu]"
			}

			action_tooltip = {
				click_type = right
				click_mode = single
				cursor = "unit_transport"

				visible = "[UnitMarkerItem.RightClickToEmbark]"
				title = "EMBARK_ACTION"
				on_action = "[UnitMarkerItem.OnRightClick]"
			}

			action_tooltip = {
				click_type = right
				click_mode = single
				cursor = "unit_movement"

				visible = "[UnitMarkerItem.RightClickToJoin]"
				title = "UNIT_CLICK_TOOLTIP_RIGHT_CLICK_JOIN"
				on_action = "[UnitMarkerItem.OnRightClick]"
			}

			action_tooltip = {
				click_type = right
				click_mode = single
				cursor = "merge_unit"

				visible = "[UnitMarkerItem.RightClickToMerge]"
				title = "MERGE_UNITS"
				on_action = "[UnitMarkerItem.OnRightClick]"
			}

			action_tooltip = {
				click_type = right
				click_mode = single
				cursor = "unit_chasing"

				visible = "[UnitMarkerItem.RightClickToChase]"
				title = "UNIT_CLICK_TOOLTIP_RIGHT_CLICK_CHASE"
				on_action = "[UnitMarkerItem.OnRightClick]"
			}
		}

		unit_marker_navy_button = {
			size = { 100% 100% }
			visible = "[And(UnitMarkerItem.IsPlayer, Not(Unit.IsArmy))]"

			tagtooltip_enabled = yes
			tooltip = "[UnitMarkerItem.GetTooltip]"
			contextmenu_widget = {
				UnitMarkerContextMenu = {}
			}

			action_tooltip = {
				click_type = left
				click_mode = single

				visible = "[UnitMarkerItem.IsPlayer]"
				title = "UNIT_CLICK_TOOLTIP_LEFT_CLICK"
				on_action = "[UnitMarkerItem.OnClick]"
			}

			action_tooltip = {
				click_type = right
				click_mode = single

				visible = "[And(And(And(And(Not(UnitMarkerItem.RightClickToJoin),Not(UnitMarkerItem.RightClickToMerge)),Not(UnitMarkerItem.RightClickToEmbark)),Not(UnitMarkerItem.RightClickToChase)), UnitMarkerItem.IsPlayer)]"
				cursor = "unit_menu"
				title = "UNIT_CLICK_TOOLTIP_RIGHT_CLICK"
				on_action = "[PdxGuiWidget.ToggleContextMenu]"
			}

			action_tooltip = {
				click_type = right
				click_mode = single
				cursor = "unit_transport"

				visible = "[UnitMarkerItem.RightClickToEmbark]"
				title = "EMBARK_ACTION"
				on_action = "[UnitMarkerItem.OnRightClick]"
			}

			action_tooltip = {
				click_type = right
				click_mode = single
				cursor = "unit_movement"

				visible = "[UnitMarkerItem.RightClickToJoin]"
				title = "UNIT_CLICK_TOOLTIP_RIGHT_CLICK_JOIN"
				on_action = "[UnitMarkerItem.OnRightClick]"
			}

			action_tooltip = {
				click_type = right
				click_mode = single
				cursor = "merge_unit"

				visible = "[UnitMarkerItem.RightClickToMerge]"
				title = "MERGE_UNITS"
				on_action = "[UnitMarkerItem.OnRightClick]"
			}

			action_tooltip = {
				click_type = right
				click_mode = single
				cursor = "unit_chasing"

				visible = "[UnitMarkerItem.RightClickToChase]"
				title = "UNIT_CLICK_TOOLTIP_RIGHT_CLICK_CHASE"
				on_action = "[UnitMarkerItem.OnRightClick]"
			}
		}
	}

	# ARMY NAVY BUTTON ENEMY
	widget = {
		size = { 100% 100% }
		visible = "[Player.IsEnemy(Unit.GetCountry.Self)]"

		unit_marker_army_button = {
