template unit_marker_item_unit_banners {
	datamodel = "[UnitMarkerItem.GetAllUnits]"
	item = {
		widget = {
			# block "item_banners_size" {
				size = { 12 15 }
			# }

			tooltipwidget = {
				using = Unit_tooltip
			}

			icon = {
				size = { 90% 90% }
				using = bg_unit_selection_shield_texture
				visible = "[IsUnitSelected(Unit.Self)]"

				using = bg_unit_selection_shield_shadow

				modify_texture = {
					using = color_gold_texture
				}

				modify_texture = {
					using = overlay_stone_texture
					blend_mode = overlay
					alpha = 0.5
				}
			}

			icon = {
				size = { 90% 90% }
				using = bg_unit_selection_shield_texture
				visible = "[Not(IsUnitSelected(Unit.Self))]"

				using = bg_unit_selection_shield_shadow

				using = marker_unit_side_color

				modify_texture = {
					using = overlay_stone_texture
					blend_mode = overlay
					alpha = 0.5
				}
			}
		}
	}
}

