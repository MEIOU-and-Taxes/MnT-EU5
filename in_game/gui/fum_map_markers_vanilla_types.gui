			}
	
			action_tooltip = {
				click_type = right
				click_mode = single
				cursor = "unit_transport"
	
				visible = "[And(UnitMarkerItem.RightClickToJoin, UnitMarkerItem.GetUnit.IsNavy)]"
				title = "EMBARK_ACTION"
