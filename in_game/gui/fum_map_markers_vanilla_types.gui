				visible = "[And(UnitMarkerItem.RightClickToJoin, Not(UnitMarkerItem.GetUnit.IsNavy))]"
				title = "UNIT_CLICK_TOOLTIP_RIGHT_CLICK_JOIN"
				on_action = "[UnitMarkerItem.OnRightClick]"
			}
	
			action_tooltip = {
