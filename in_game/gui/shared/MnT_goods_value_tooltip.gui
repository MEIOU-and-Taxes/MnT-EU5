template Mnt_Goods_Value_Tooltip {
	ContextualTooltipType = {
		blockoverride "title_text" {
			raw_text = "Gross Output"
		}

		blockoverride "title_icon" {
			icon = {
				using = tooltip_title_icon_size
				texture = "gfx/interface/icons/map_modes/GDP.dds"
			}
		}

		blockoverride "concept_link" {
			text = [mnt_wealth_gross_output|E]
		}

		blockoverride "tooltip_content" {
			datacontext = "[Player]"

			hbox = {
				layoutpolicy_horizontal = expanding
				spacing = 10
				vbox = {
					spacing = 6
					using = bg_text_mask_container_dark_brown
					using = bg_cabinet_card_frame
					margin = { 6 6 }

					hbox = {
						layoutpolicy_horizontal = expanding
						text_single = {
							align = left|nobaseline
							autoresize = yes
							default_format = "#t"
							raw_text = "Output Share"
						}
						expand = {}
					}

					hbox = {
						layoutpolicy_horizontal = expanding
						expand = {}
						piechart = {
							using = bg_circle
							size = { 80 80 }

							using = piechart_angles
							tooltipwidget = {
								ContextualTooltipType = {
									blockoverride "title_icon" {
										icon = {
											using = tooltip_title_icon_size
											texture = "gfx/interface/icons/resources/gold.dds"
										}
									}
									blockoverride "title_text" {
										text = "Output Share"
									}

									blockoverride "tooltip_content" {
										TooltipTextBlock = {
											blockoverride "text" {
												raw_text = "Urban [Select_CFixedPoint(GreaterThan_CFixedPoint(Player.MakeScope.GetVariable('mnt_wealth_national_gross_output').GetValue, '(CFixedPoint)0'), Divide_CFixedPoint(Player.MakeScope.GetVariable('mnt_wealth_national_urban_gross_output').GetValue, Player.MakeScope.GetVariable('mnt_wealth_national_gross_output').GetValue), '(CFixedPoint)0')|%0] ([Player.MakeScope.GetVariable('mnt_wealth_national_urban_gross_output').GetValue|2]@gold!)"
												default_format = "#W"
											}
										}
										TooltipTextBlock = {
											blockoverride "text" {
												raw_text = "Rural [Select_CFixedPoint(GreaterThan_CFixedPoint(Player.MakeScope.GetVariable('mnt_wealth_national_gross_output').GetValue, '(CFixedPoint)0'), Divide_CFixedPoint(Player.MakeScope.GetVariable('mnt_wealth_national_rural_gross_output').GetValue, Player.MakeScope.GetVariable('mnt_wealth_national_gross_output').GetValue), '(CFixedPoint)0')|%0] ([Player.MakeScope.GetVariable('mnt_wealth_national_rural_gross_output').GetValue|2]@gold!)"
												default_format = "#W"
											}
										}
									}
								}
							}

							pieslice_no_highlight = {
								texture = "gfx/interface/pie_charts/pie_chart_alpha_80.dds"
								value = "[FixedPointToFloat(Select_CFixedPoint(GreaterThan_CFixedPoint(Player.MakeScope.GetVariable('mnt_wealth_national_gross_output').GetValue, '(CFixedPoint)0'), Divide_CFixedPoint(Player.MakeScope.GetVariable('mnt_wealth_national_urban_gross_output').GetValue, Player.MakeScope.GetVariable('mnt_wealth_national_gross_output').GetValue), '(CFixedPoint)0'))]"
								color = { 1.0 0.6 0.1 1.0 }
							}

							pieslice_no_highlight = {
								texture = "gfx/interface/pie_charts/pie_chart_alpha_80_green.dds"
								value = "[Subtract_float('(float)1.0', FixedPointToFloat(Select_CFixedPoint(GreaterThan_CFixedPoint(Player.MakeScope.GetVariable('mnt_wealth_national_gross_output').GetValue, '(CFixedPoint)0'), Divide_CFixedPoint(Player.MakeScope.GetVariable('mnt_wealth_national_urban_gross_output').GetValue, Player.MakeScope.GetVariable('mnt_wealth_national_gross_output').GetValue), '(CFixedPoint)0')))]"
								color = { 1 1 1 1 }
							}

							icon = {
								size = { 36 36 }
								parentanchor = center
								texture = "gfx/interface/icons/resources/gold.dds"
							}

							using = bg_circle_piechart
						}
						expand = {}
					}
				}
				vbox = {
					layoutpolicy_horizontal = expanding
					spacing = 6
					hbox = {
						layoutpolicy_horizontal = expanding
						spacing = 6
						TooltipTextBlock = {
							blockoverride "text" {
								text = "MNT_URBAN_GDP_LINE"
								default_format = "#help"
							}
							tooltip = "MNT_URBAN_GDP_DESC"
							tooltipwidget = { using = Mnt_Goods_Value_Urban_Breakdown }
						}
						expand = {}
						mapmode_tooltip_button = {
							datacontext = "[GetMapMode('goods_value_urban')]"
						}
					}

					hbox = {
						layoutpolicy_horizontal = expanding
						spacing = 6
						TooltipTextBlock = {
							blockoverride "text" {
								text = "MNT_RURAL_GDP_LINE"
								default_format = "#help"
							}
							tooltip = "MNT_RURAL_GDP_DESC"
							tooltipwidget = { using = Mnt_Goods_Value_Rural_Breakdown }
						}
						expand = {}
						mapmode_tooltip_button = {
							datacontext = "[GetMapMode('goods_value_rural')]"
						}
					}
				}
			}
		}
	}
}

template Mnt_Goods_Value_Urban_Breakdown {
	ContextualTooltipType = {
		blockoverride "title_text" { raw_text = "Urban Goods Output Breakdown" }
		blockoverride "tooltip_content" {
			datacontext = "[Player]"
			TooltipListScrollArea = {
				blockoverride "block_scrollarea" { maximumsize = { -1 700 } }
				blockoverride "scrollarea_content" {
					vbox = {
						spacing = 4
						set_parent_dimension_to_minimum = height
						TooltipManualTableField = {
							blockoverride "row_size" { maximumsize = { -1 22 } minimumsize = { -1 22 } }
							blockoverride "field_content" {
								block "table_field_margin" { margin = { 6 0 } }
								spacing = 6
								text_single = { align = left|nobaseline autoresize = no minimumsize = { 130 -1 } maximumsize = { 130 -1 } raw_text = "[goods|e]" }
								text_single = { align = center|nobaseline autoresize = no minimumsize = { 50 -1 } maximumsize = { 50 -1 } raw_text = "[location|e]" }
								text_single = { align = center|nobaseline autoresize = no minimumsize = { 90 -1 } maximumsize = { 90 -1 } raw_text = "[gold|e]" }
								expand = {}
								text_single = { align = right|nobaseline autoresize = no minimumsize = { 90 -1 } maximumsize = { 90 -1 } raw_text = "[gold|e] / [location|e]" }
							}
						}
						vbox = {
							spacing = 4
							set_parent_dimension_to_minimum = height
							datamodel = "[Player.MakeScope.GetList('mnt_wealth_national_goods')]"
							item = {
								TooltipManualTableField = {
									datacontext = "[Scope.GetGoods]"
									blockoverride "visibility" { visible = "[GreaterThan_CFixedPoint(Goods.MakeScope.ScriptValue('mnt_wealth_good_is_urban'), '(CFixedPoint)0')]" }
									blockoverride "row_size" { maximumsize = { -1 22 } minimumsize = { -1 22 } }
									blockoverride "field_content" {
										block "table_field_margin" { margin = { 6 0 } }
										spacing = 6
										icon = { size = { 20 20 } texture = "[GetGoodsIcon(Goods.Self)]" texture_density = 2 }
										text_single = { align = left|nobaseline autoresize = no minimumsize = { 130 -1 } maximumsize = { 130 -1 } raw_text = "[Goods.GetNameWithNoTooltip]" }
										text_single = { align = center|nobaseline autoresize = no minimumsize = { 50 -1 } maximumsize = { 50 -1 } raw_text = "[Player.MakeScope.GetVariableFromVariableMap('mnt_wealth_national_goods_locations', Goods.MakeScope).GetValue|0]" }
										text_single = { align = right|nobaseline autoresize = no minimumsize = { 90 -1 } maximumsize = { 90 -1 } raw_text = "[Player.MakeScope.GetVariableFromVariableMap('mnt_wealth_national_goods_value', Goods.MakeScope).GetValue|2]@gold!" }
										expand = {}
										text_single = { align = right|nobaseline autoresize = no minimumsize = { 90 -1 } maximumsize = { 90 -1 } raw_text = "[Divide_CFixedPoint(Player.MakeScope.GetVariableFromVariableMap('mnt_wealth_national_goods_value', Goods.MakeScope).GetValue, Player.MakeScope.GetVariableFromVariableMap('mnt_wealth_national_goods_locations', Goods.MakeScope).GetValue)|2]@gold!" }
									}
								}
							}
						}
					}
				}
			}
		}
	}
}

template Mnt_Goods_Value_Rural_Breakdown {
	ContextualTooltipType = {
		blockoverride "title_text" { raw_text = "Rural Goods Output Breakdown" }
		blockoverride "tooltip_content" {
			datacontext = "[Player]"
			TooltipListScrollArea = {
				blockoverride "block_scrollarea" { maximumsize = { -1 700 } }
				blockoverride "scrollarea_content" {
					vbox = {
						spacing = 4
						set_parent_dimension_to_minimum = height
						TooltipManualTableField = {
							blockoverride "row_size" { maximumsize = { -1 22 } minimumsize = { -1 22 } }
							blockoverride "field_content" {
								block "table_field_margin" { margin = { 6 0 } }
								spacing = 6
								text_single = { align = left|nobaseline autoresize = no minimumsize = { 130 -1 } maximumsize = { 130 -1 } raw_text = "[goods|e]" }
								text_single = { align = center|nobaseline autoresize = no minimumsize = { 50 -1 } maximumsize = { 50 -1 } raw_text = "[location|e]" }
								text_single = { align = center|nobaseline autoresize = no minimumsize = { 90 -1 } maximumsize = { 90 -1 } raw_text = "[gold|e]" }
								expand = {}
								text_single = { align = right|nobaseline autoresize = no minimumsize = { 90 -1 } maximumsize = { 90 -1 } raw_text = "[gold|e] / [location|e]" }
							}
						}
						vbox = {
							spacing = 4
							set_parent_dimension_to_minimum = height
							datamodel = "[Player.MakeScope.GetList('mnt_wealth_national_goods')]"
							item = {
								TooltipManualTableField = {
									datacontext = "[Scope.GetGoods]"
									blockoverride "visibility" { visible = "[EqualTo_CFixedPoint(Goods.MakeScope.ScriptValue('mnt_wealth_good_is_urban'), '(CFixedPoint)0')]" }
									blockoverride "row_size" { maximumsize = { -1 22 } minimumsize = { -1 22 } }
									blockoverride "field_content" {
										block "table_field_margin" { margin = { 6 0 } }
										spacing = 6
										icon = { size = { 20 20 } texture = "[GetGoodsIcon(Goods.Self)]" texture_density = 2 }
										text_single = { align = left|nobaseline autoresize = no minimumsize = { 130 -1 } maximumsize = { 130 -1 } raw_text = "[Goods.GetNameWithNoTooltip]" }
										text_single = { align = center|nobaseline autoresize = no minimumsize = { 50 -1 } maximumsize = { 50 -1 } raw_text = "[Player.MakeScope.GetVariableFromVariableMap('mnt_wealth_national_goods_locations', Goods.MakeScope).GetValue|0]" }
										text_single = { align = right|nobaseline autoresize = no minimumsize = { 90 -1 } maximumsize = { 90 -1 } raw_text = "[Player.MakeScope.GetVariableFromVariableMap('mnt_wealth_national_goods_value', Goods.MakeScope).GetValue|2]@gold!" }
										expand = {}
										text_single = { align = right|nobaseline autoresize = no minimumsize = { 90 -1 } maximumsize = { 90 -1 } raw_text = "[Divide_CFixedPoint(Player.MakeScope.GetVariableFromVariableMap('mnt_wealth_national_goods_value', Goods.MakeScope).GetValue, Player.MakeScope.GetVariableFromVariableMap('mnt_wealth_national_goods_locations', Goods.MakeScope).GetValue)|2]@gold!" }
									}
								}
							}
						}
					}
				}
			}
		}
	}
}
