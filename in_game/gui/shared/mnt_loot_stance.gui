# Looting stance cell for the military panel (unit_overview.gui). One button is visible at a time and
# cycles Restrained > Moderate > Ruthless. Other mods can redefine this type or override "mnt_loot_stance_content".

types MnTLootStanceTypes
{
	type mnt_loot_stance_cell = widget {
		size = { 45 45 }

		block "mnt_loot_stance_content" {
			header_action_button_left = {
				parentanchor = center
				size = { 36 36 }
				visible = "[And(Not(GetScriptedGui('mnt_wealth_loot_stance_is_moderate').IsShown(GuiScope.SetRoot(UnitOverview.GetPlayer.MakeScope).End)), Not(GetScriptedGui('mnt_wealth_loot_stance_is_ruthless').IsShown(GuiScope.SetRoot(UnitOverview.GetPlayer.MakeScope).End)))]"
				blockoverride "button_icon_stretch_sprite" {}
				blockoverride "header_button_frame_inner" { visible = no }
				blockoverride "header_button_icon_size" { size = { 36 36 } }
				blockoverride "header_button_text_layout" {}
				blockoverride "icon_texture" {
					size = { 100% 100% }
					texture = "gfx/interface/icons/modifier_types/amount_looted_modifier.dds"
				}
				title = "mnt_wealth_loot_stance_title_restrained"
				actor = "[UnitOverview.GetPlayer]"
				left_action = { action_name = "mnt_wealth_set_loot_stance_moderate" }
			}
			header_action_button_left = {
				parentanchor = center
				size = { 36 36 }
				visible = "[GetScriptedGui('mnt_wealth_loot_stance_is_moderate').IsShown(GuiScope.SetRoot(UnitOverview.GetPlayer.MakeScope).End)]"
				blockoverride "button_icon_stretch_sprite" {}
				blockoverride "header_button_frame_inner" { visible = no }
				blockoverride "header_button_icon_size" { size = { 36 36 } }
				blockoverride "header_button_text_layout" {}
				blockoverride "icon_texture" {
					size = { 100% 100% }
					texture = "gfx/interface/icons/modifier_types/amount_looted_modifier.dds"
				}
				title = "mnt_wealth_loot_stance_title_moderate"
				actor = "[UnitOverview.GetPlayer]"
				left_action = { action_name = "mnt_wealth_set_loot_stance_ruthless" }
			}
			header_action_button_left = {
				parentanchor = center
				size = { 36 36 }
				visible = "[GetScriptedGui('mnt_wealth_loot_stance_is_ruthless').IsShown(GuiScope.SetRoot(UnitOverview.GetPlayer.MakeScope).End)]"
				blockoverride "button_icon_stretch_sprite" {}
				blockoverride "header_button_frame_inner" { visible = no }
				blockoverride "header_button_icon_size" { size = { 36 36 } }
				blockoverride "header_button_text_layout" {}
				blockoverride "icon_texture" {
					size = { 100% 100% }
					texture = "gfx/interface/icons/modifier_types/amount_looted_modifier.dds"
				}
				title = "mnt_wealth_loot_stance_title_ruthless"
				actor = "[UnitOverview.GetPlayer]"
				left_action = { action_name = "mnt_wealth_set_loot_stance_restrained" }
			}
		}
	}
}
