# MnT - Centers of Importance: the tiles on the location picture.
# location_window.gui instantiates one subtype per category. Every card the player can open
# is defined once and referenced by name:
#
#   mnt_center_tier_<cat>_<tier>   one tier: what it grants and the score it needs
#   mnt_center_factors_<cat>       the breakdown of that category's score
#   mnt_center_tree_<cat>          the progression, tier by tier
#   mnt_center_mapmode_<cat>       the button opening that category's mapmode
#
types MnT_center_slots
{
	# one tile: paper-card frame, an icon per tier (grey when the location holds none)
	type mnt_center_slot = widget {
		size = { 29 29 }

		using = bg_paper_card
		block "mnt_center_slot_tint" {}

		block "mnt_center_slot_none" {}
		block "mnt_center_slot_local" {}
		block "mnt_center_slot_regional" {}
		block "mnt_center_slot_continental" {}
		block "mnt_center_slot_world" {}
	}

	# mapmode buttons, one per category
	type mnt_center_mapmode_trade = mapmode_tooltip_button {
		datacontext = "[GetMapMode('center_trade')]"
	}
	type mnt_center_mapmode_production = mapmode_tooltip_button {
		datacontext = "[GetMapMode('center_production')]"
	}
	type mnt_center_mapmode_culture = mapmode_tooltip_button {
		datacontext = "[GetMapMode('center_culture')]"
	}
	type mnt_center_mapmode_education = mapmode_tooltip_button {
		datacontext = "[GetMapMode('center_education')]"
	}

	# category content
	type mnt_center_slot_trade = mnt_center_slot {
		blockoverride "mnt_center_slot_tint" {
			background = {
				using = color_economy_texture
				alpha = 0.7
			}
		}
		blockoverride "mnt_center_slot_none" {
			icon = {
				size = { 22 22 }
				parentanchor = center
				visible = "[Not(GetScriptedGui('mnt_center_trade_shown_any').IsShown(GuiScope.SetRoot(LocationView.GetLocation.MakeScope).End))]"
				texture = "gfx/interface/icons/centers/trade_local.dds"
				shaderfile = "gfx/FX/pdxgui_grayscale.shader"
				effectname = "PdxGuiGrayscale"
			}
			tooltipwidget = {
				ContextualTooltipType = {
					blockoverride "title_text" {
						text = "MNT_NO_TRADE_CENTER_TITLE"
						default_format = "#explanation_link"
						tooltipwidget = { using = mnt_center_tree_trade }
					}
					blockoverride "title_icon_texture" {
						texture = "gfx/interface/icons/centers/trade_local.dds"
					}
					blockoverride "title_button" {
						mnt_center_mapmode_trade = {}
					}
					blockoverride "tooltip_content" {
						TooltipTextBlock = {
							blockoverride "text" {
								text = "MNT_NO_TRADE_CENTER"
							}
						}
						hbox = {
							spacing = 3
							tooltipwidget = { using = mnt_center_factors_trade }
							text_single = {
								default_format = "#explanation_link"
								raw_text = "[LocationView.GetLocation.MakeScope.ScriptValue('mnt_center_trade_score')|0] /"
							}
							text_single = {
								default_format = "#explanation_link"
								raw_text = "[LocationView.GetLocation.MakeScope.ScriptValue('center_trade_local_threshold')|0]"
							}
							text_single = {
								default_format = "#explanation_link"
								text = "MNT_CENTER_SCORE_LOCAL"
								tooltipwidget = { using = mnt_center_tier_trade_local }
							}
						}
						progressbar = {
							size = { 260 10 }
							using = morale_progressbar_bar
							value = "[Multiply_float(Min_float(FixedPointToFloat(Divide_CFixedPoint(LocationView.GetLocation.MakeScope.ScriptValue('mnt_center_trade_score'), LocationView.GetLocation.MakeScope.ScriptValue('center_trade_local_threshold'))), '(float)1.0'), '(float)100')]"
						}
					}
				}
			}
		}
		blockoverride "mnt_center_slot_local" {
			icon = {
				size = { 22 22 }
				parentanchor = center
				visible = "[GetScriptedGui('mnt_center_trade_local_shown').IsShown(GuiScope.SetRoot(LocationView.GetLocation.MakeScope).End)]"
				texture = "gfx/interface/icons/centers/trade_local.dds"
				glow = {
					name = "drop_shadow"
					glow_radius = 3
					color = { 0.0 0.0 0.0 1.0 }
					alpha = 0.4
				}
			}
			tooltipwidget = {
				ContextualTooltipType = {
					blockoverride "title_text" {
						text = "[GetModifier('mnt_center_trade_local').GetNameWithNoTooltip]"
						default_format = "#explanation_link"
						tooltipwidget = { using = mnt_center_tree_trade }
					}
					blockoverride "title_icon_texture" {
						texture = "gfx/interface/icons/centers/trade_local.dds"
					}
					blockoverride "title_button" {
						mnt_center_mapmode_trade = {}
					}
					blockoverride "tooltip_content" {
						TooltipStringPairList = {
							textcontext = "[ShowModifierEffect('mnt_center_trade_local')]"
						}
						hbox = {
							spacing = 3
							tooltipwidget = { using = mnt_center_factors_trade }
							text_single = {
								default_format = "#explanation_link"
								raw_text = "[LocationView.GetLocation.MakeScope.ScriptValue('mnt_center_trade_score')|0] /"
							}
							text_single = {
								default_format = "#explanation_link"
								raw_text = "[LocationView.GetLocation.MakeScope.ScriptValue('center_trade_regional_threshold')|0]"
							}
							text_single = {
								default_format = "#explanation_link"
								text = "MNT_CENTER_SCORE_REGIONAL"
								tooltipwidget = { using = mnt_center_tier_trade_regional }
							}
						}
						progressbar = {
							size = { 260 10 }
							using = morale_progressbar_bar
							value = "[Multiply_float(Min_float(FixedPointToFloat(Divide_CFixedPoint(LocationView.GetLocation.MakeScope.ScriptValue('mnt_center_trade_score'), LocationView.GetLocation.MakeScope.ScriptValue('center_trade_regional_threshold'))), '(float)1.0'), '(float)100')]"
						}
					}
				}
			}
		}
		blockoverride "mnt_center_slot_regional" {
			icon = {
				size = { 22 22 }
				parentanchor = center
				visible = "[GetScriptedGui('mnt_center_trade_regional_shown').IsShown(GuiScope.SetRoot(LocationView.GetLocation.MakeScope).End)]"
				texture = "gfx/interface/icons/centers/trade_regional.dds"
				glow = {
					name = "drop_shadow"
					glow_radius = 3
					color = { 0.0 0.0 0.0 1.0 }
					alpha = 0.4
				}
			}
			tooltipwidget = {
				ContextualTooltipType = {
					blockoverride "title_text" {
						text = "[GetModifier('mnt_center_trade_regional').GetNameWithNoTooltip]"
						default_format = "#explanation_link"
						tooltipwidget = { using = mnt_center_tree_trade }
					}
					blockoverride "title_icon_texture" {
						texture = "gfx/interface/icons/centers/trade_regional.dds"
					}
					blockoverride "title_button" {
						mnt_center_mapmode_trade = {}
					}
					blockoverride "tooltip_content" {
						TooltipStringPairList = {
							textcontext = "[ShowModifierEffect('mnt_center_trade_regional')]"
						}
						hbox = {
							spacing = 3
							tooltipwidget = { using = mnt_center_factors_trade }
							text_single = {
								default_format = "#explanation_link"
								raw_text = "[LocationView.GetLocation.MakeScope.ScriptValue('mnt_center_trade_score')|0] /"
							}
							text_single = {
								default_format = "#explanation_link"
								raw_text = "[LocationView.GetLocation.MakeScope.ScriptValue('center_trade_continental_threshold')|0]"
							}
							text_single = {
								default_format = "#explanation_link"
								text = "MNT_CENTER_SCORE_CONTINENTAL"
								tooltipwidget = { using = mnt_center_tier_trade_continental }
							}
						}
						progressbar = {
							size = { 260 10 }
							using = morale_progressbar_bar
							value = "[Multiply_float(Min_float(FixedPointToFloat(Divide_CFixedPoint(LocationView.GetLocation.MakeScope.ScriptValue('mnt_center_trade_score'), LocationView.GetLocation.MakeScope.ScriptValue('center_trade_continental_threshold'))), '(float)1.0'), '(float)100')]"
						}
					}
				}
			}
		}
		blockoverride "mnt_center_slot_continental" {
			icon = {
				size = { 22 22 }
				parentanchor = center
				visible = "[GetScriptedGui('mnt_center_trade_continental_shown').IsShown(GuiScope.SetRoot(LocationView.GetLocation.MakeScope).End)]"
