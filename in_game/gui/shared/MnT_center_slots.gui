	type mnt_center_slot_culture = mnt_center_slot {
		blockoverride "mnt_center_slot_tint" {
			background = {
				using = color_society_texture
				alpha = 0.7
			}
		}
		blockoverride "mnt_center_slot_none" {
			icon = {
				size = { 22 22 }
