				position = { 10 10 }
				size = { 180 180 }
				alwaystransparent = yes
				background = { texture = "gfx/interface/mnt_wealth/mnt_wealth_ring_edge_brown.dds" texture_density = 2 }
			}

			text_single = {
				parentanchor = top|right
				position = { -10 42 }
				autoresize = yes
				max_update_rate = 6
				default_format = "#color_yellow"
				tooltipwidget = { using = mnt_wealth_wage_rate_tooltip }
				raw_text = "[LocationView.GetLocation.MakeScope.ScriptValue('mnt_wealth_wage_rate_percent')|1]%@gold!"
			}

			text_single = {
				parentanchor = top|right
				position = { -10 64 }
				autoresize = yes
				max_update_rate = 4
				visible = "[And(LessThanOrEqualTo_CFixedPoint(LocationView.GetLocation.MakeScope.ScriptValue('mnt_wealth_band'), '(CFixedPoint)0.5'), GreaterThanOrEqualTo_CFixedPoint(LocationView.GetLocation.MakeScope.ScriptValue('mnt_wealth_local_wealth_total'), '(CFixedPoint)100'))]"
				default_format = "#color_red"
				tooltipwidget = { using = mnt_wealth_center_tooltip }
				raw_text = "[LocationView.GetLocation.MakeScope.ScriptValue('mnt_wealth_local_wealth_total')|0]@gold!"
			}
			text_single = {
				parentanchor = top|right
				position = { -10 64 }
				autoresize = yes
				max_update_rate = 4
				visible = "[And(LessThanOrEqualTo_CFixedPoint(LocationView.GetLocation.MakeScope.ScriptValue('mnt_wealth_band'), '(CFixedPoint)0.5'), And(GreaterThanOrEqualTo_CFixedPoint(LocationView.GetLocation.MakeScope.ScriptValue('mnt_wealth_local_wealth_total'), '(CFixedPoint)10'), LessThan_CFixedPoint(LocationView.GetLocation.MakeScope.ScriptValue('mnt_wealth_local_wealth_total'), '(CFixedPoint)100')))]"
				default_format = "#color_red"
				tooltipwidget = { using = mnt_wealth_center_tooltip }
				raw_text = "[LocationView.GetLocation.MakeScope.ScriptValue('mnt_wealth_local_wealth_total')|1]@gold!"
			}
			text_single = {
				parentanchor = top|right
				position = { -10 64 }
				autoresize = yes
				max_update_rate = 4
				visible = "[And(LessThanOrEqualTo_CFixedPoint(LocationView.GetLocation.MakeScope.ScriptValue('mnt_wealth_band'), '(CFixedPoint)0.5'), LessThan_CFixedPoint(LocationView.GetLocation.MakeScope.ScriptValue('mnt_wealth_local_wealth_total'), '(CFixedPoint)10'))]"
				default_format = "#color_red"
				tooltipwidget = { using = mnt_wealth_center_tooltip }
				raw_text = "[LocationView.GetLocation.MakeScope.ScriptValue('mnt_wealth_local_wealth_total')|2]@gold!"
			}

			text_single = {
				parentanchor = top|right
				position = { -10 64 }
				autoresize = yes
				max_update_rate = 4
				visible = "[And(And( GreaterThan_CFixedPoint(LocationView.GetLocation.MakeScope.ScriptValue('mnt_wealth_band'), '(CFixedPoint)0.5'), LessThanOrEqualTo_CFixedPoint(LocationView.GetLocation.MakeScope.ScriptValue('mnt_wealth_band'), '(CFixedPoint)1.5') ), GreaterThanOrEqualTo_CFixedPoint(LocationView.GetLocation.MakeScope.ScriptValue('mnt_wealth_local_wealth_total'), '(CFixedPoint)100'))]"
				default_format = "#color_orange"
				tooltipwidget = { using = mnt_wealth_center_tooltip }
				raw_text = "[LocationView.GetLocation.MakeScope.ScriptValue('mnt_wealth_local_wealth_total')|0]@gold!"
			}
			text_single = {
				parentanchor = top|right
				position = { -10 64 }
				autoresize = yes
				max_update_rate = 4
				visible = "[And(And( GreaterThan_CFixedPoint(LocationView.GetLocation.MakeScope.ScriptValue('mnt_wealth_band'), '(CFixedPoint)0.5'), LessThanOrEqualTo_CFixedPoint(LocationView.GetLocation.MakeScope.ScriptValue('mnt_wealth_band'), '(CFixedPoint)1.5') ), And(GreaterThanOrEqualTo_CFixedPoint(LocationView.GetLocation.MakeScope.ScriptValue('mnt_wealth_local_wealth_total'), '(CFixedPoint)10'), LessThan_CFixedPoint(LocationView.GetLocation.MakeScope.ScriptValue('mnt_wealth_local_wealth_total'), '(CFixedPoint)100')))]"
				default_format = "#color_orange"
