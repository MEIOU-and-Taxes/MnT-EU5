		mnt_wealth_formula_row = {
			blockoverride "row_label" { raw_text = "= Monthly Investment" }
			blockoverride "row_value" { block "investment_monthly_bold_value" { raw_text = "" } }
		}
	}
}

template mnt_wealth_decay_rows {
	TooltipListBase = {
		blockoverride "block_title" { visible = no }

		mnt_wealth_formula_row = {
			blockoverride "row_attributes" { tooltipwidget = { using = mnt_wealth_estate_desired_wealth_tooltip } }
			blockoverride "row_label" { raw_text = "Invested Wealth" }
			blockoverride "row_value" { block "decay_invested_value" { raw_text = "" } }
		}
		mnt_wealth_formula_row = {
			blockoverride "row_label" { raw_text = "× Decay Rate / Month" }
			blockoverride "row_value" { raw_text = "[Multiply_float(DCEstateDecayRate(), '(float)100')|2]%" }
		}
		mnt_wealth_formula_row = {
			blockoverride "row_attributes" {
				tooltipwidget = {
					ContextualTooltipType = {
						blockoverride "title_text" { raw_text = "#T Decay Resistance#!" }
						blockoverride "tooltip_content" {
							TooltipStringPairList = {
								layoutpolicy_horizontal = expanding
								textcontext = "[LocationView.GetLocation.GetDescriptionFor('mnt_wealth_local_decay_resistance')]"
							}
							TooltipStringPairList = {
								layoutpolicy_horizontal = expanding
								textcontext = "[LocationView.GetLocation.GetOwner.GetDescriptionFor('mnt_wealth_global_decay_resistance')]"
							}
						}
					}
				}
			}
			blockoverride "row_label" { raw_text = "× #explanation_link Decay Resistance#!" }
			blockoverride "row_value" { raw_text = "[FixedPointToFloat(LocationScriptValue('mnt_wealth_decay_resistance_multiplier'))|2]" }
		}
		mnt_wealth_formula_row = {
			blockoverride "row_label" { raw_text = "= Monthly Decay" }
			blockoverride "row_value" { block "decay_monthly_bold_value" { raw_text = "" } }
		}
	}
}

