template mnt_wealth_estate_investment_tooltip {
	mnt_wealth_investment_tooltip_base = {
		blockoverride "invest_solid" { value = "[DCInvestmentSolidBar()]" }
		blockoverride "neglect_solid" { value = "[DCNeglectSolidBar()]" }
		blockoverride "level_number" {
			icon = {
				parentanchor = center
				size = { 100% 100% }
				texture = "gfx/interface/progressbars/empty_circle_bg.dds"

				color = {
					0.5
					0.4
					0.3
					1
				}
			}

			text_single = {
				parentanchor = center
				position = { 0 -6 }
				align = center|nobaseline
				fontsize = 14
				max_update_rate = 30
				visible = "[GreaterThanOrEqualTo_float(DCInvestmentLevel(), '(float)1')]"
				raw_text = "#G #bold [DCProjectedWholeLevelInt()]#!"
			}
			text_single = {
				parentanchor = center
				position = { 0 -6 }
				align = center|nobaseline
				fontsize = 14
				max_update_rate = 30
				visible = "[LessThanOrEqualTo_float(DCInvestmentLevel(), '(float)-1')]"
				raw_text = "#R #bold [DCProjectedWholeLevelInt()]#!"
			}
			text_single = {
				parentanchor = center
				position = { 0 -6 }
				align = center|nobaseline
				fontsize = 14
				max_update_rate = 30
				visible = "[And(GreaterThan_float(DCInvestmentLevel(), '(float)-1'), LessThan_float(DCInvestmentLevel(), '(float)1'))]"
				raw_text = "#high #bold 0#!"
			}
		}
		blockoverride "size_label" {
			raw_text = "[Select_CString(LessThan_float(DCInvestmentLevel(), '(float)0'), 'Neglect Level', 'Investment Level')]"
		}
		blockoverride "size_value" { raw_text = "[DCInvestmentLevel()|2+=]" }
		blockoverride "target_label" {
			raw_text = "[Select_CString(LessThan_float(DCInvestmentEquilibrium(), '(float)0'), 'Neglect Equilibrium Level', 'Investment Equilibrium Level')]"
		}
		blockoverride "target_value" { raw_text = "[DCInvestmentEquilibrium()|2+=]" }
		blockoverride "investment_tooltip" {
			tooltipwidget = {
				ContextualTooltipType = {
					blockoverride "title_icon" {
						icon = { using = tooltip_title_icon_size texture = "[GetConceptTexture('mnt_wealth_investment_rate')]" }
					}
					blockoverride "title_text" { raw_text = "#T Monthly Investment#!" }
					blockoverride "concept_link" { text = "[mnt_wealth_local_investment|E]" }
					blockoverride "tooltip_content" {
						using = mnt_wealth_investment_rows
						blockoverride "investment_wealth_tooltip" { tooltipwidget = { using = mnt_wealth_estate_wealth_tooltip_bound } }
						blockoverride "investment_estate_wealth_value" { raw_text = "[DCDisplayedEstateWealth()|2]@gold!" }
						blockoverride "investment_monthly_bold_value" { raw_text = "#bold [DCMonthlyInvestment()|2+=]#!@gold!" }
					}
				}
			}
		}
		blockoverride "investment_monthly_value" { raw_text = "[DCMonthlyInvestment()|2+=]@gold!" }
		blockoverride "investment_progress_label" {
			raw_text = "[Select_CString(LessThan_float(DCInvestmentLevel(), '(float)0'), 'Neglect Progress', 'Investment Progress')]"
		}
		blockoverride "investment_progress_value" {
			raw_text = "([DCMonthlyChangeAfterSeizure()|2+=]) #bold [DCInvestmentProgressGold()|2]#!@gold! / [Multiply_float(DCNextLevelTotalCost(), Select_float(LessThan_float(DCInvestmentLevel(), '(float)0'), '(float)-1', '(float)1'))|2]@gold!"
		}
		blockoverride "bar_tooltip" {
			tooltipwidget = {
				ContextualTooltipType = {
					blockoverride "title_icon" { icon = { using = tooltip_title_icon_size texture = "[GetEstateIcon(Estate.GetType)]" } }
					blockoverride "title_text" { raw_text = "#T [Estate.GetType.GetNameWithNoTooltip] Investment#!" }
					blockoverride "concept_link" { text = "[mnt_wealth_local_investment|E]" }
					blockoverride "tooltip_content" {
						TooltipListBase = {
							mnt_wealth_formula_row = {
								blockoverride "row_label" { raw_text = "Current" }
								blockoverride "row_value" { raw_text = "#bold [DCInvestmentLevel()|2]#!" }
							}
						}
						vbox = {
							layoutpolicy_horizontal = expanding
							ignoreinvisible = yes
							datamodel = "[LocationView.GetLocation.GetTimedModifiers]"

							item = {
								TooltipStringPairList = {
									layoutpolicy_horizontal = expanding
									visible = "[Or( EqualTo_string(TimedModifier.GetModifier.GetName, GetModifier(DCInvestmentModifierKey()).GetName), EqualTo_string(TimedModifier.GetModifier.GetName, GetModifier(DCNeglectModifierKey()).GetName) )]"
									textcontext = "[TimedModifier.GetModifierEffect]"
								}
							}
						}
					}
				}
			}
		}
		blockoverride "decay_monthly_value" { raw_text = "[Subtract_float('(float)0', DCMonthlyDecay())|2+=]@gold!" }
		blockoverride "seizure_monthly_value" { raw_text = "[Subtract_float('(float)0', DCSeizureFromInvested())|2+=]@gold!" }
		blockoverride "decay_tooltip" {
			tooltipwidget = {
				ContextualTooltipType = {
					blockoverride "title_icon" {
						icon = { using = tooltip_title_icon_size texture = "[GetConceptTexture('mnt_wealth_investment_rate')]" }
					}
					blockoverride "title_text" { raw_text = "#T Monthly Decay#!" }
					blockoverride "concept_link" { text = "[mnt_wealth_expected_wealth|E]" }
					blockoverride "tooltip_content" {
						using = mnt_wealth_decay_rows
						blockoverride "decay_invested_value" { raw_text = "[DCInvestedWealth()|2]@gold!" }
						blockoverride "decay_monthly_bold_value" { raw_text = "#bold [Subtract_float('(float)0', DCMonthlyDecay())|2+=]#!@gold!" }
					}
				}
			}
		}
		blockoverride "level_cost_tooltip" {
			tooltipwidget = {
				ContextualTooltipType = {
					blockoverride "title_icon" { icon = { using = tooltip_title_icon_size texture = "[GetConceptTexture('mnt_wealth_gross_output')]" } }
					blockoverride "title_text" { raw_text = "#T Gold for One Level#!" }
					blockoverride "concept_link" { text = "[mnt_wealth_local_investment|E]" }
					blockoverride "tooltip_content" {
						using = mnt_wealth_level_cost_rows
						blockoverride "cost_base_value" { raw_text = "[LevelCostBase()|2]@gold!" }
						blockoverride "cost_level_multiplier_value" { raw_text = "[Add_float(Multiply_float('(float)2', DCWholeLevel()), '(float)1')|2]" }
						blockoverride "cost_this_level_label" {
							raw_text = "[Select_CString(GreaterThanOrEqualTo_float(DCInvestmentLevel(), '(float)0'), '= Cost of This Level', '= Cost to Recover This Level')]"
						}
						blockoverride "cost_this_level_bold_value" { raw_text = "#bold [DCCurrentLevelCost()|2]#!@gold!" }
						blockoverride "cost_previous_levels_value" { raw_text = "[DCPreviousLevelsCost()|2]@gold!" }
						blockoverride "cost_this_level_value" { raw_text = "[DCCurrentLevelCost()|2+=]@gold!" }
						blockoverride "cost_next_level_total_value" { raw_text = "#bold [DCNextLevelTotalCost()|2]#!@gold!" }
					}
				}
			}
		}
		blockoverride "impact_icons" {
			widget = {
				position = { 4 24 }
				size = { 35 35 }

				icon = {
					parentanchor = center
					size = { 35 35 }
					visible = "[LessThan_float(DCMonthlyChangeAfterSeizure(), '(float)0')]"
					texture = "gfx/interface/progressbars/red_circle_bg.dds"

					color = {
						0.5
						0.4
						0.3
						1
					}
				}
				icon = {
					parentanchor = center
					size = { 35 35 }
					visible = "[Not(LessThan_float(DCMonthlyChangeAfterSeizure(), '(float)0'))]"
					texture = "gfx/interface/progressbars/empty_circle_bg.dds"

					color = {
						0.5
						0.4
						0.3
						1
					}
				}

				icon = {
					parentanchor = center
					size = { 23 23 }
					texture = "[GetConceptTexture(DCNeglectModifierKey())]"
					texture_density = 2

					tooltipwidget = {
						ContextualTooltipType = {
							blockoverride "title_icon" { icon = { using = tooltip_title_icon_size texture = "[GetConceptTexture(DCNeglectModifierKey())]" } }
							blockoverride "title_text" { raw_text = "#T Each Level of [Estate.GetType.GetNameWithNoTooltip] Neglect#!" }
							blockoverride "concept_link" { text = "[mnt_wealth_local_investment|E]" }
							blockoverride "tooltip_content" {
								TooltipStringPairList = {
									blockoverride "block_title" { visible = no }
									layoutpolicy_horizontal = expanding
									textcontext = "[GetModifier(DCNeglectModifierKey()).GetDesc]"
								}
							}
						}
					}
				}
			}
			widget = {
				position = { 331 24 }
				size = { 35 35 }

				icon = {
					parentanchor = center
					size = { 35 35 }
					visible = "[GreaterThan_float(DCMonthlyChangeAfterSeizure(), '(float)0')]"
					texture = "gfx/interface/progressbars/green_circle_bg.dds"

					color = {
						0.5
						0.4
						0.3
						1
					}
				}
				icon = {
					parentanchor = center
					size = { 35 35 }
					visible = "[Not(GreaterThan_float(DCMonthlyChangeAfterSeizure(), '(float)0'))]"
					texture = "gfx/interface/progressbars/empty_circle_bg.dds"

					color = {
						0.5
						0.4
						0.3
						1
					}
				}

				icon = {
					parentanchor = center
					size = { 23 23 }
					texture = "[GetConceptTexture(DCInvestmentModifierKey())]"
					texture_density = 2

					tooltipwidget = {
						ContextualTooltipType = {
							blockoverride "title_icon" { icon = { using = tooltip_title_icon_size texture = "[GetConceptTexture(DCInvestmentModifierKey())]" } }
							blockoverride "title_text" { raw_text = "#T Each Level of [Estate.GetType.GetNameWithNoTooltip] Investment#!" }
							blockoverride "concept_link" { text = "[mnt_wealth_local_investment|E]" }
							blockoverride "tooltip_content" {
								TooltipStringPairList = {
									blockoverride "block_title" { visible = no }
									layoutpolicy_horizontal = expanding
									textcontext = "[GetModifier(DCInvestmentModifierKey()).GetDesc]"
								}
							}
						}
					}
				}
			}
		}
	}
}

types MnTWealthTypes
{
	type mnt_wealth_donut = widget {
		parentanchor = bottom|right
		position = { -44 0 }
		size = { 138 138 }
		scissor = yes
		allow_outside = no
		visible = "[LocationView.GetLocation.HasOwner]"

		widget = {
			position = { 32 32 }
			size = { 212 212 }
			alwaystransparent = yes

			background = {
				texture = "gfx/interface/mnt_wealth/mnt_wealth_ring_mask.dds"
				texture_density = 2
				modify_texture = { using = color_black_texture }
			}
		}

		widget = {
			position = { 28 28 }
			size = { 220 220 }
			alwaystransparent = yes
			background = { texture = "gfx/interface/mnt_wealth/mnt_wealth_ring_edge_brown.dds" texture_density = 2 }
		}

		piechart = {
			position = { 32 32 }
			size = { 212 212 }
			filter_mouse = none
			startangle = 180
			endangle = 90

			pieslice = {
				mask = "gfx/interface/mnt_wealth/mnt_wealth_ring_mask.dds"
				texture = "gfx/interface/pie_charts/pie_chart_alpha_80.dds"
