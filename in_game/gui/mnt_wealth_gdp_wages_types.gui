template mnt_wealth_estate_wealth_tooltip_bound {
	using = mnt_wealth_estate_wealth_tooltip
	blockoverride "local_estate_wealth_tooltip" { tooltipwidget = { using = mnt_wealth_local_estate_wealth_tooltip } }
	blockoverride "local_estate_wealth" { raw_text = "#bold [DCDisplayedEstateWealth()|2]#!@gold!" }
	blockoverride "wealth_share_tooltip" { tooltipwidget = { using = mnt_wealth_share_drift_tooltip } }
	blockoverride "wealth_share_drift_tooltip" { tooltipwidget = { using = mnt_wealth_drift_gold_tooltip } }
	blockoverride "wealth_share_drift_gold" { raw_text = "[DCWealthShareDriftGold()|2+=]@gold!" }
	blockoverride "wealth_share_display" {
		raw_text = "([FixedPointToFloat(DCWealthShareDrift())|%2+=]) [FixedPointToFloat(DCEstateWealthFraction())|%0]"
	}
	blockoverride "wage_residual_tooltip" { tooltipwidget = { using = mnt_wealth_estate_wage_residual_tooltip } }
	blockoverride "wage_residual_value" { raw_text = "[DCEstateIncome()|2+=]@gold!" }
	blockoverride "estate_investment_tooltip" { tooltipwidget = { using = mnt_wealth_estate_treasury_row } }
	blockoverride "estate_investment_value" { raw_text = "[DCEstateLocalFlow()|2+=]@gold!" }
	blockoverride "invested_outflow_tooltip" { tooltipwidget = { using = mnt_wealth_estate_invested_row } }
	blockoverride "invested_outflow_value" { raw_text = "[Subtract_float('(float)0', DCEstateInvestedGold())|2+=]@gold!" }
	blockoverride "wealth_change" { raw_text = "([DCEstateWealthChange()|2+=]) #bold [DCDisplayedEstateWealth()|2]#!@gold!" }
	blockoverride "desired_wealth_tooltipwidget" { tooltipwidget = { using = mnt_wealth_estate_desired_wealth_tooltip } }
	blockoverride "desired_wealth_label" { raw_text = "[Estate.GetType.GetNameWithNoTooltip] Investment Decay" }
	blockoverride "desired_wealth_value" { raw_text = "[DCMonthlyDecay()|2]@gold!" }
}

