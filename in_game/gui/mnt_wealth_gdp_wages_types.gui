								}
							}
						}
					}
					blockoverride "row_label" { raw_text = "[ShowModifierTypeName('mnt_wealth_local_wage_modifier')]" }
					blockoverride "row_value" { raw_text = "[LocationView.GetLocation.GetModifierValue('mnt_wealth_local_wage_modifier')]" }
				}
				mnt_wealth_formula_row = {
					blockoverride "row_attributes" {
						tooltipwidget = {
