}

template mnt_wealth_gross_output_header_text {
	text_single = {
		align = nobaseline
		max_update_rate = 4
		visible = "[LocationView.GetLocation.HasOwner]"
		raw_text = "[LocationView.GetLocation.MakeScope.ScriptValue('mnt_wealth_live_gross_output')|2]@gold!"
		tooltipwidget = { using = mnt_wealth_gross_output_header_tooltip }
	}
}

template mnt_wealth_gross_output_header_tooltip {
	ContextualTooltipType = {
		blockoverride "title_icon" { icon = { using = tooltip_title_icon_size texture = "[GetConceptTexture('mnt_wealth_gross_output')]" } }
		blockoverride "title_text" { raw_text = "#T Local Gross Output#!" }
		blockoverride "concept_link" { text = "[mnt_wealth_gross_output|E]" }

		blockoverride "tooltip_content" {
			TooltipListBase = {
				mnt_wealth_formula_row = {
					blockoverride "row_label" { raw_text = "Current Gross Output" }
					blockoverride "row_value" {
						raw_text = "#color_yellow [LocationView.GetLocation.MakeScope.ScriptValue('mnt_wealth_live_gross_output')|2]#!@gold!"
					}
				}
				mnt_wealth_formula_row = {
					blockoverride "row_label" { raw_text = "#explanation_link [Concept('mnt_wealth_cached_gross_output','GDP at Last Survey')]#!" }
					blockoverride "row_value" {
						raw_text = "#color_yellow [LocationView.GetLocation.MakeScope.ScriptValue('mnt_wealth_local_gross_output_value')|2]#!@gold!"
					}
				}
			}
			TooltipListBase = {
				blockoverride "block_title" { raw_text = "#T Goods Produced#!" }
				TooltipListScrollArea = {
					blockoverride "block_scrollarea" { maximumsize = { -1 180 } minimumsize = { -1 30 } }
					blockoverride "scrollarea_content" {
						vbox = {
							set_parent_dimension_to_minimum = height
							layoutpolicy_horizontal = expanding
							datamodel = "[LocationView.GetLocationGoodsItems]"

							item = {
								mnt_wealth_formula_row = {
									blockoverride "row_icon" {
										icon = {
											size = { 20 20 }
											texture = "[GetGoodsIcon(LocationGoodItem.GetGoods)]"
											texture_density = 2
										}
									}
									blockoverride "row_label" { raw_text = "[LocationGoodItem.GetGoods.GetNameWithNoTooltip]" }
									blockoverride "row_value_attributes" { min_width = 150 }
									blockoverride "row_value" {
										raw_text = "[LocationGoodItem.GetTotalOutput|2]@supply! #W (#!#color_yellow [Multiply_CFixedPoint(LocationGoodItem.GetTotalOutput, LocationView.GetLocation.GetMarket.GetPrice(LocationGoodItem.GetGoods))|2]@gold!#!#W )#!"
									}
								}
							}
						}
					}
				}
			}
		}
	}
}

template mnt_wealth_wage_rate_tooltip {
	ContextualTooltipType = {
		blockoverride "title_icon" { icon = { using = tooltip_title_icon_size texture = "[GetConceptTexture('mnt_wealth_wages')]" } }
		blockoverride "title_text" { raw_text = "#T Wage Rate#!" }
		blockoverride "concept_link" { text = "[mnt_wealth_wages|E]" }

		blockoverride "tooltip_content" {
			# Section one: the wage rate is the local wage modifier plus the national one.
			TooltipListBase = {
				blockoverride "block_title" { raw_text = "#T Wage Rate#!" }

				mnt_wealth_formula_row = {
					blockoverride "row_attributes" {
						tooltipwidget = {
							ContextualTooltipType = {
								blockoverride "title_text" { raw_text = "#T [ShowModifierTypeName('mnt_wealth_local_wage_modifier')]#!" }
								blockoverride "tooltip_content" {
									TooltipStringPairList = {
										layoutpolicy_horizontal = expanding
