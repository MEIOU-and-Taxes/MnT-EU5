# Shared widget types that the templates and cards below instantiate.

types MnTWealthBaseTypes
{
	# One row of a formula tooltip: a label on the left, a value on the right and any additional optional row attributes
	type mnt_wealth_formula_row = TooltipManualTableField {
		block "row_attributes" {  }
		blockoverride "field_content" {
			block "row_icon" {  }

			text_single = {
				layoutpolicy_horizontal = expanding
				max_update_rate = 4
				block "row_label" { raw_text = "" }
			}
			text_single = {
				align = right
				min_width = 90
				max_update_rate = 4
				block "row_value_attributes" {  }
				block "row_value" { raw_text = "" }
			}
		}
	}

	type mnt_wealth_bar_tick = icon {
		size = { 2 13 }
		texture = "gfx/interface/progressbars/progress_black.dds"
		spriteType = Corneredstretched
		spriteborder = { 1 1 }
		modify_texture = { using = color_white_texture }
		alpha = 0.55
		max_update_rate = 4
		block "tick_at" {  }
	}

	type mnt_wealth_investment_tooltip_base = ContextualTooltipType {
		blockoverride "title_icon" { icon = { using = tooltip_title_icon_size texture = "[GetEstateIcon(Estate.GetType)]" } }
		blockoverride "title_text" { raw_text = "#T [Estate.GetType.GetNameWithNoTooltip] Estate#!" }
		blockoverride "concept_link" { text = "[mnt_wealth_local_investment|E]" }

		blockoverride "tooltip_content" {
			widget = {
				size = { 373 62 }

				widget = {
					position = { 162 5 }
					size = { 48 48 }
					block "level_number" {  }
				}

				widget = {
					position = { 16 30 }
					size = { 340 22 }
					background = { using = color_black_texture alpha = 0.75 }
					using = bg_paper_card
					using = bg_cabinet_card_frame
					block "bar_tooltip" {  }

					progressbar = {
						position = { 20 5 }
						size = { 150 13 }
						mirror = horizontal
						min = 0
						max = 1
						direction = horizontal
						progresstexture = "gfx/interface/progressbars/progress_bar_red_alt.dds"
						noprogresstexture = "gfx/interface/icons/unit_view/moral_bar_transparent.dds"
						texture_density = 2
						spriteType = Corneredstretched
						spriteborder = { 12 0 }
						max_update_rate = 4
						block "neglect_solid" {  }
					}

					progressbar = {
						position = { 170 5 }
						size = { 150 13 }
						min = 0
						max = 1
						direction = horizontal
						progresstexture = "gfx/interface/progressbars/progress_bar_green_alt.dds"
						noprogresstexture = "gfx/interface/icons/unit_view/moral_bar_transparent.dds"
						texture_density = 2
						spriteType = Corneredstretched
						spriteborder = { 12 0 }
						max_update_rate = 4
						block "invest_solid" {  }
					}

					icon = {
						position = { 169 2 }
						size = { 2 18 }
						texture = "gfx/interface/progressbars/progress_black.dds"
						spriteType = Corneredstretched
						spriteborder = { 1 1 }
						modify_texture = { using = color_white_texture }
						alpha = 0.95
					}
				}

				block "impact_icons" {  }
			}

			TooltipListBase = {
				blockoverride "block_title" { visible = no }

				mnt_wealth_formula_row = {
					blockoverride "row_label" { block "size_label" { raw_text = "" } }
					blockoverride "row_value" { block "size_value" { raw_text = "" } }
				}
				mnt_wealth_formula_row = {
					blockoverride "row_label" { block "target_label" { raw_text = "" } }
					blockoverride "row_value" { block "target_value" { raw_text = "" } }
				}
			}

			TooltipListBase = {
				blockoverride "block_title" { visible = no }

				mnt_wealth_formula_row = {
					blockoverride "row_attributes" { block "investment_tooltip" {  } }
					blockoverride "row_label" { raw_text = "Monthly Investment" }
					blockoverride "row_value" { block "investment_monthly_value" { raw_text = "" } }
				}
				mnt_wealth_formula_row = {
					blockoverride "row_attributes" { block "decay_tooltip" {  } }
					blockoverride "row_label" { raw_text = "+ Monthly Decay" }
					blockoverride "row_value" { block "decay_monthly_value" { raw_text = "" } }
				}

				mnt_wealth_formula_row = {
					blockoverride "row_attributes" { visible = "[GreaterThan_float(DCSeizureFromInvested(), '(float)0')]" }
					blockoverride "row_label" { raw_text = "+ National Asset Seizure" }
					blockoverride "row_value" { block "seizure_monthly_value" { raw_text = "" } }
				}

				divider_solid_gold = {  }

				mnt_wealth_formula_row = {
					blockoverride "row_attributes" { block "level_cost_tooltip" {  } }
					blockoverride "row_label" { block "investment_progress_label" { raw_text = "" } }
					blockoverride "row_value_attributes" { min_width = 120 }
					blockoverride "row_value" { block "investment_progress_value" { raw_text = "" } }
				}
			}
		}
	}
}

# A wealth-system entry in a location's modifier list. The card on the
# illustration already shows this information, so the list hides these.
# Each row is matched against the wealth system's own modifiers, so a new
# modifier added to the system has to be listed here as well.

template mnt_wealth_hide_if_wealth_modifier {
	max_update_rate = 30
	visible = "[Not(IsWealthModifier())]"
}

# Shrinks a hidden wealth-modifier icon slot to nothing so the row of icons
# closes the gap instead of leaving blank space.

template mnt_wealth_collapse_if_wealth_modifier_small {
	size = "[Select_CVector2f(Not(IsWealthModifier()), '(CVector2f)26,26', '(CVector2f)0,0')]"
}

# The crown holds no local wealth, so it is skipped.

template mnt_wealth_desired_wealth_tooltip {
	ContextualTooltipType = {
		blockoverride "title_icon" {
			icon = { using = tooltip_title_icon_size texture = "[GetConceptTexture('mnt_wealth_expected_wealth')]" }
		}
		blockoverride "title_text" { raw_text = "#T Investment Decay#!" }
		blockoverride "concept_link" { text = "[mnt_wealth_expected_wealth|E]" }

		blockoverride "tooltip_content" {
			TooltipListBase = {
				vbox = {
					layoutpolicy_horizontal = expanding
					datamodel = "[DataModelSkipFirst(LocationView.GetLocation.GetOwner.GetGovernment.GetEstates, '(int32)1')]"

					item = {
						mnt_wealth_formula_row = {
							blockoverride "row_attributes" {
								tooltipwidget = { using = mnt_wealth_estate_desired_wealth_tooltip }
								visible = "[GreaterThan_float(DCMonthlyDecay(), '(float)0')]"
							}
							blockoverride "row_icon" {
								icon = {
									size = { 20 20 }
									texture = "[GetEstateIcon(Estate.GetType)]"
									texture_density = 2
								}
							}
							blockoverride "row_label" { raw_text = "[Estate.GetType.GetNameWithNoTooltip]" }
							blockoverride "row_value" { raw_text = "[DCMonthlyDecay()|2]@gold!" }
						}
					}
				}
			}
		}
	}
}

template mnt_wealth_estate_desired_wealth_tooltip {
	ContextualTooltipType = {
		blockoverride "title_icon" { icon = { using = tooltip_title_icon_size texture = "[GetEstateIcon(Estate.GetType)]" } }
		blockoverride "title_text" { raw_text = "#T [Estate.GetType.GetNameWithNoTooltip] Investment Decay#!" }
		blockoverride "concept_link" { text = "[mnt_wealth_expected_wealth|E]" }

		blockoverride "tooltip_content" {
			TooltipListBase = {
				mnt_wealth_formula_row = {
					blockoverride "row_label" { raw_text = "Invested Wealth" }
					blockoverride "row_value" {
						raw_text = "[DCInvestedWealth()|2]@gold!"
					}
				}
				mnt_wealth_formula_row = {
					blockoverride "row_label" { raw_text = "× Decay Rate / Month" }
					blockoverride "row_value" {
						raw_text = "[Multiply_float(DCEstateDecayRate(), '(float)100')|2]%"
					}
				}

				divider_solid_gold = {  }

				mnt_wealth_formula_row = {
					blockoverride "row_label" { raw_text = "= Monthly Decay" }
					blockoverride "row_value" { raw_text = "#bold [DCMonthlyDecay()|2]#!@gold!" }
				}
			}
		}
	}
}

template mnt_wealth_center_tooltip {
	ContextualTooltipType = {
		blockoverride "title_icon" { icon = { using = tooltip_title_icon_size texture = "[GetConceptTexture('mnt_wealth_local_wealth')]" } }
		blockoverride "title_text" { raw_text = "#T Local Wealth#!" }
		blockoverride "concept_link" { text = "[mnt_wealth_local_wealth|E]" }

		blockoverride "tooltip_content" {
			TooltipListBase = {
				mnt_wealth_formula_row = {
					blockoverride "row_label" { raw_text = "#explanation_link [Concept('mnt_wealth_local_wealth','Local Wealth')]#!" }
					blockoverride "row_value" {
						raw_text = "#bold [LocationView.GetLocation.MakeScope.ScriptValue('mnt_wealth_local_wealth_total')|2]#!@gold!"
					}
				}
				mnt_wealth_formula_row = {
					blockoverride "row_attributes" { tooltipwidget = { using = mnt_wealth_desired_wealth_tooltip } }
					blockoverride "row_label" { raw_text = "Baseline" }
					blockoverride "row_value" { raw_text = "[LocationView.GetLocation.MakeScope.ScriptValue('mnt_wealth_baseline')|2]@gold!" }
				}
			}
			TooltipListBase = {
				mnt_wealth_formula_row = {
					blockoverride "row_attributes" { tooltipwidget = { using = mnt_wealth_wage_residuals_tooltip } }
					blockoverride "row_label" { raw_text = "#explanation_link [Concept('mnt_wealth_wages','Wages')]#!" }
					blockoverride "row_value" {
						raw_text = "[LocationView.GetLocation.MakeScope.ScriptValue('mnt_wealth_local_wage_pool')|2+=]@gold!"
					}
				}
				mnt_wealth_formula_row = {
					blockoverride "row_attributes" { tooltipwidget = { using = mnt_wealth_estate_treasury_tooltip } }
					blockoverride "row_label" {
						raw_text = "#explanation_link [Concept('mnt_wealth_national_estate_investments','National Estate Investments')]#!"
					}
					blockoverride "row_value" {
						raw_text = "[LocationView.GetLocation.MakeScope.ScriptValue('mnt_wealth_estate_flow_total')|2+=]@gold!"
					}
				}
				mnt_wealth_formula_row = {
					blockoverride "row_attributes" { tooltipwidget = { using = mnt_wealth_investment_spending_tooltip } }
					blockoverride "row_label" { raw_text = "#explanation_link [Concept('mnt_wealth_investment_spending','Local Wealth Invested')]#!" }
					blockoverride "row_value" {
						raw_text = "[Subtract_float('(float)0', Multiply_float(FixedPointToFloat(LocationScriptValue('mnt_wealth_local_wealth_total')), FixedPointToFloat(LocationScriptValue('mnt_wealth_investment_rate'))))|2+=]@gold!"
					}
				}

				divider_solid_gold = {  }

				mnt_wealth_formula_row = {
					blockoverride "row_label" { raw_text = "#explanation_link [Concept('mnt_wealth_local_wealth','Local Wealth')]#!" }
					blockoverride "row_value" {
						raw_text = "([LocationView.GetLocation.MakeScope.ScriptValue('mnt_wealth_local_wealth_change')|2+=]) #bold [LocationView.GetLocation.MakeScope.ScriptValue('mnt_wealth_local_wealth_total')|2]#!@gold!"
					}
				}
			}
		}
	}
}

template mnt_wealth_wage_residuals_tooltip {
	ContextualTooltipType = {
		blockoverride "title_icon" { icon = { using = tooltip_title_icon_size texture = "[GetConceptTexture('mnt_wealth_wages')]" } }
		blockoverride "title_text" { raw_text = "#T Wages#!" }
		blockoverride "concept_link" { text = "[mnt_wealth_wages|E]" }

		blockoverride "tooltip_content" {
			TooltipListBase = {
				mnt_wealth_formula_row = {
					blockoverride "row_attributes" { tooltipwidget = { using = mnt_wealth_gross_output_header_tooltip } }
					blockoverride "row_label" { raw_text = "#explanation_link [Concept('mnt_wealth_cached_gross_output','GDP at Last Survey')]#!" }
					blockoverride "row_value" { raw_text = "[LocationView.GetLocation.MakeScope.ScriptValue('mnt_wealth_local_gross_output_value')|2]@gold!" }
				}
				mnt_wealth_formula_row = {
					blockoverride "row_attributes" { tooltipwidget = { using = mnt_wealth_wage_rate_tooltip } }
					blockoverride "row_label" { raw_text = "× Wage Rate" }
					blockoverride "row_value" { raw_text = "[LocationView.GetLocation.MakeScope.ScriptValue('mnt_wealth_wage_rate_percent')|1]%" }
				}

				divider_solid_gold = {  }

				mnt_wealth_formula_row = {
					blockoverride "row_label" { raw_text = "= Wages" }
					blockoverride "row_value" {
						raw_text = "#bold [LocationView.GetLocation.MakeScope.ScriptValue('mnt_wealth_local_wage_pool')|2+=]#!@gold!"
					}
				}
			}
		}
	}
}

template mnt_wealth_estate_treasury_tooltip {
	ContextualTooltipType = {
		blockoverride "title_icon" {
			icon = { using = tooltip_title_icon_size texture = "[GetConceptTexture('mnt_wealth_national_estate_investments')]" }
		}
		blockoverride "title_text" { raw_text = "#T National Estate Investments#!" }
		blockoverride "concept_link" { text = "[mnt_wealth_national_estate_investments|E]" }

		blockoverride "tooltip_content" {
			TooltipListBase = {
				vbox = {
					layoutpolicy_horizontal = expanding
					datamodel = "[DataModelSkipFirst(LocationView.GetLocation.GetOwner.GetGovernment.GetEstates, '(int32)1')]"

					item = {
						mnt_wealth_formula_row = {
							blockoverride "row_attributes" {
								tooltipwidget = { using = mnt_wealth_estate_treasury_row }
								visible = "[DCEstateIsPresent()]"
							}
							blockoverride "row_icon" {
								icon = {
									size = { 20 20 }
									texture = "[GetEstateIcon(Estate.GetType)]"
									texture_density = 2
								}
							}
							blockoverride "row_label" { raw_text = "[Estate.GetType.GetNameWithNoTooltip]" }
							blockoverride "row_value" { raw_text = "[DCEstateLocalFlow()|2+=]@gold!" }
						}
					}
				}
			}
		}
	}
}

template mnt_wealth_savings_percentage_tooltip {
	ContextualTooltipType = {
		blockoverride "title_icon" { icon = { using = tooltip_title_icon_size texture = "[GetEstateIcon(Estate.GetType)]" } }
		blockoverride "title_text" {
			raw_text = "#T [Estate.GetType.GetNameWithNoTooltip] [Select_CString(GreaterThan_CFixedPoint(Estate.MakeScope.ScriptValue('mnt_wealth_estate_savings_ratio'), '(CFixedPoint)1'), 'Monthly Investment', 'Monthly Asset Seizure')]#!"
		}
		blockoverride "concept_link" { text = "[mnt_wealth_national_estate_investments|E]" }
		blockoverride "tooltip_content" {
			TooltipListBase = {
				mnt_wealth_formula_row = {
					blockoverride "row_label" { raw_text = "[Estate.GetType.GetNameWithNoTooltip] Treasury" }
					blockoverride "row_value" { raw_text = "[Estate.GetGold|2]@gold!" }
				}
				mnt_wealth_formula_row = {
					blockoverride "row_label" { raw_text = "- National Savings Goal" }
					blockoverride "row_value" { raw_text = "[Estate.MakeScope.ScriptValue('mnt_wealth_estate_savings_goal')|2]@gold!" }
				}

				divider_solid_gold = {  }
				# Treasury gap, spread over a year and capped per month.
				mnt_wealth_formula_row = {
					blockoverride "row_label" {
						raw_text = "= [Select_CString(GreaterThan_CFixedPoint(Estate.MakeScope.ScriptValue('mnt_wealth_estate_savings_ratio'), '(CFixedPoint)1'), 'Treasury Surplus', 'Treasury Shortfall')]"
					}
					blockoverride "row_value" {
						raw_text = "[Subtract_CFixedPoint(Estate.GetGold, Estate.MakeScope.ScriptValue('mnt_wealth_estate_savings_goal'))|2+=]@gold!"
					}
				}
				mnt_wealth_formula_row = { blockoverride "row_label" { raw_text = "÷ 12 Months" } blockoverride "row_value" { raw_text = "12" } }
				# Only the seizing side carries the built-up demand.
				mnt_wealth_formula_row = {
					blockoverride "row_attributes" {
						visible = "[LessThanOrEqualTo_CFixedPoint(Estate.MakeScope.ScriptValue('mnt_wealth_estate_savings_ratio'), '(CFixedPoint)1')]"
						tooltipwidget = { using = mnt_wealth_seizure_demand_tooltip }
					}
					blockoverride "row_label" { raw_text = "× #explanation_link Seizure Demand#!" }
					blockoverride "row_value" { raw_text = "[Estate.MakeScope.ScriptValue('mnt_wealth_estate_seizure_multiplier')|2]" }
				}

				mnt_wealth_formula_row = {
					blockoverride "row_attributes" {
						visible = "[LessThanOrEqualTo_CFixedPoint(Estate.MakeScope.ScriptValue('mnt_wealth_estate_savings_ratio'), '(CFixedPoint)1')]"
					}
					blockoverride "row_label" { raw_text = "Capped per Month at" }
					blockoverride "row_value" { raw_text = "[Estate.MakeScope.ScriptValue('mnt_wealth_estate_seizure_cap')|2]@gold!" }
				}

				mnt_wealth_formula_row = {
					blockoverride "row_attributes" {
						visible = "[GreaterThan_CFixedPoint(Estate.MakeScope.ScriptValue('mnt_wealth_estate_savings_ratio'), '(CFixedPoint)1')]"
					}
					blockoverride "row_label" { raw_text = "Capped per Month at" }
					blockoverride "row_value" { raw_text = "[Estate.MakeScope.ScriptValue('mnt_wealth_estate_payout_cap')|2]@gold!" }
				}

				divider_solid_gold = {  }

				mnt_wealth_formula_row = {
					blockoverride "row_label" {
						raw_text = "= [Select_CString(GreaterThan_CFixedPoint(Estate.MakeScope.ScriptValue('mnt_wealth_estate_savings_ratio'), '(CFixedPoint)1'), 'Invested into Local Wealth', 'Seized from Local Wealth')]"
					}
					blockoverride "row_value" {
						raw_text = "#bold [Estate.MakeScope.ScriptValue('mnt_wealth_estate_location_investment')|2+=]#!@gold!"
					}
				}
			}
		}
	}
}

# The drill-down behind the seizure demand row. One way only: nothing in here
# points back at the tooltip that opened it.

template mnt_wealth_seizure_demand_tooltip {
	ContextualTooltipType = {
		blockoverride "title_icon" { icon = { using = tooltip_title_icon_size texture = "[GetEstateIcon(Estate.GetType)]" } }
		blockoverride "title_text" { raw_text = "#T [Estate.GetType.GetNameWithNoTooltip] Seizure Demand#!" }
		blockoverride "concept_link" { text = "[mnt_wealth_asset_seizure|E]" }

		blockoverride "tooltip_content" {
			TooltipTextBlock = {
				blockoverride "text" {
					raw_text = "An estate that cannot reach its savings goal presses harder on its locations the longer it stays short. The shortfall counts seized gold against the estate: the treasury must exceed the goal by what was seized before the estate counts as solvent, so demand keeps growing until organic income alone would cover the goal. Once that happens the demand fades instead of clearing, so a single good month does not undo years of pressure."
				}
			}
			TooltipListBase = {
				mnt_wealth_formula_row = {
					blockoverride "row_label" { raw_text = "Demand Built Up" }
					blockoverride "row_value" { raw_text = "[Estate.MakeScope.ScriptValue('mnt_wealth_estate_seizure_demand_level')|2]" }
				}

				mnt_wealth_formula_row = {
					blockoverride "row_attributes" {
						visible = "[GreaterThan_CFixedPoint(Estate.MakeScope.ScriptValue('mnt_wealth_estate_seizure_demand_growth'), '(CFixedPoint)0')]"
					}
					blockoverride "row_label" { raw_text = "+ Added This Month" }
					blockoverride "row_value" { raw_text = "[Estate.MakeScope.ScriptValue('mnt_wealth_estate_seizure_demand_growth')|2]" }
				}

				mnt_wealth_formula_row = {
					blockoverride "row_attributes" {
						visible = "[LessThanOrEqualTo_CFixedPoint(Estate.MakeScope.ScriptValue('mnt_wealth_estate_seizure_demand_growth'), '(CFixedPoint)0')]"
					}
					blockoverride "row_label" { raw_text = "Fading While At Goal, per Month" }
					blockoverride "row_value" { raw_text = "[Estate.MakeScope.ScriptValue('mnt_wealth_seizure_demand_decay')|%0]" }
				}

				divider_solid_gold = {  }

				mnt_wealth_formula_row = {
					blockoverride "row_label" { raw_text = "= Seizure Multiplied By" }
					blockoverride "row_value" { raw_text = "#bold [Estate.MakeScope.ScriptValue('mnt_wealth_estate_seizure_multiplier')|2]#!" }
				}
			}
		}
	}
}

template mnt_wealth_estate_treasury_row {
	ContextualTooltipType = {
		blockoverride "title_icon" { icon = { using = tooltip_title_icon_size texture = "[GetEstateIcon(Estate.GetType)]" } }
		blockoverride "title_text" {
			raw_text = "#T [Estate.GetType.GetNameWithNoTooltip] [Select_CString(DCEstateIsInvesting(), 'Estate Investment', 'Asset Seizure')]#!"
		}
		blockoverride "concept_link" { text = "[mnt_wealth_national_estate_investments|E]" }
		blockoverride "tooltip_content" {
			TooltipListBase = {
				mnt_wealth_formula_row = {
					blockoverride "row_attributes" { tooltipwidget = { using = mnt_wealth_savings_percentage_tooltip } }
					blockoverride "row_label" {
						raw_text = "[Estate.GetType.GetNameWithNoTooltip] Monthly [Select_CString(DCEstateIsInvesting(), 'Investment', 'Seizure')]"
					}
					blockoverride "row_value" { raw_text = "[DCEstateFlowTotal()|2+=]@gold!" }
				}
				mnt_wealth_formula_row = {
					blockoverride "row_label" { raw_text = "× This Location's Share of [Estate.GetType.GetNameWithNoTooltip] Estate Raw Power" }
					blockoverride "row_value" { raw_text = "[DCEstateLocalPayoutShare()|%1]" }
				}

				divider_solid_gold = {  }

				mnt_wealth_formula_row = {
					blockoverride "row_label" {
						raw_text = "= [Estate.GetType.GetNameWithNoTooltip] [Select_CString(DCEstateIsInvesting(), 'Invested Here', 'Seized Here')]"
					}
					blockoverride "row_value" { raw_text = "#bold [DCEstateLocalFlow()|2+=]#!@gold!" }
				}

				# Invested wealth seizure line, visible only when liquid wealth could not cover it.
				mnt_wealth_formula_row = {
					blockoverride "row_attributes" { visible = "[Not(DCEstateIsInvesting())]" }
					blockoverride "row_label" { raw_text = " - from Local [Estate.GetType.GetNameWithNoTooltip] Wealth" }
					blockoverride "row_value" { raw_text = "[DCSeizedFromWealth()|2+=]@gold!" }
				}
				mnt_wealth_formula_row = {
					blockoverride "row_attributes" { visible = "[GreaterThan_float(DCSeizureFromInvested(), '(float)0')]" }
					blockoverride "row_label" { raw_text = " - from Local [Estate.GetType.GetNameWithNoTooltip] Investments" }
					blockoverride "row_value" { raw_text = "[DCSeizedFromInvestments()|2+=]@gold!" }
				}
			}
		}
	}
}

template mnt_wealth_investment_spending_tooltip {
	ContextualTooltipType = {
		blockoverride "title_icon" {
			icon = { using = tooltip_title_icon_size texture = "[GetConceptTexture('mnt_wealth_investment_spending')]" }
		}
		blockoverride "title_text" { raw_text = "#T Local Wealth Invested#!" }
		blockoverride "concept_link" { text = "[mnt_wealth_investment_spending|E]" }

		blockoverride "tooltip_content" {
			TooltipListBase = {
				vbox = {
					layoutpolicy_horizontal = expanding
					datamodel = "[DataModelSkipFirst(LocationView.GetLocation.GetOwner.GetGovernment.GetEstates, '(int32)1')]"

					item = {
						mnt_wealth_formula_row = {
							blockoverride "row_attributes" {
								tooltipwidget = { using = mnt_wealth_estate_invested_row }
								visible = "[GreaterThan_float(DCDisplayedEstateWealth(), '(float)0')]"
							}
							blockoverride "row_icon" {
								icon = {
									size = { 20 20 }
									texture = "[GetEstateIcon(Estate.GetType)]"
									texture_density = 2
								}
							}
							blockoverride "row_label" { raw_text = "[Estate.GetType.GetNameWithNoTooltip]" }
							blockoverride "row_value" { raw_text = "[DCEstateInvestedGold()|2]@gold!" }
						}
					}
				}
			}
		}
	}
}

template mnt_wealth_estate_invested_row {
