	type mnt_wealth_estate_status_card = widget {
		parentanchor = bottom|right
		position = { -1 -2 }
		size = { 42 100% }
		visible = "[LocationView.GetLocation.HasOwner]"

		vbox = {
			layoutpolicy_vertical = expanding
			spacing = 0
			expand = {  }

			vbox = {
				minimumsize = { 42 106 }
				margin = { 2 0 }
				spacing = 3
				visible = "[LocationView.GetLocation.HasOwner]"
				using = bg_number_container_bckg
				expand = {  }

				vbox = {
					layoutpolicy_horizontal = expanding
					spacing = 3
					datamodel = "[DataModelSkipFirst(LocationView.GetLocation.GetOwner.GetGovernment.GetEstates, '(int32)1')]"

					item = {
						hbox = {
							layoutpolicy_horizontal = expanding
							visible = "[DCEstateIsPresent()]"
							tooltipwidget = { using = mnt_wealth_estate_investment_tooltip }

							widget = {
								size = { 26 28 }

								piechart = {
									parentanchor = center
									size = { 22 22 }
									using = piechart_angles
									using = bg_circle
									using = bg_circle_piechart

									pieslice_no_highlight = {
										texture = "gfx/interface/pie_charts/pie_chart_alpha_80.dds"
										value = "[DCInvestmentSolidBar()]"

										color = {
											0.30
											0.80
											0.30
											1
										}
									}
									pieslice_no_highlight = {
										texture = "gfx/interface/pie_charts/pie_chart_alpha_80.dds"
										value = "[DCUnfilledRing()]"

										color = {
											0
											0
											0
											1
										}
									}
									pieslice_no_highlight = {
										texture = "gfx/interface/pie_charts/pie_chart_alpha_80.dds"
										value = "[DCNeglectSolidBar()]"

										color = {
											0.62
											0.18
											0.18
											1
										}
									}
								}

								icon = {
									parentanchor = center
									size = { 18 18 }
									texture = "[GetEstateIcon(Estate.GetType)]"
									texture_density = 2
								}
							}

							widget = {
								size = { 12 28 }

								text_single = {
									parentanchor = center
									align = center|nobaseline
									fontsize = 12
									fontsize_min = 6
									visible = "[GreaterThanOrEqualTo_float(DCInvestmentLevel(), '(float)1')]"
									raw_text = "#G #bold [DCProjectedWholeLevelInt()]#!"
								}
								text_single = {
									parentanchor = center
									align = center|nobaseline
									fontsize = 12
									fontsize_min = 6
									visible = "[LessThanOrEqualTo_float(DCInvestmentLevel(), '(float)-1')]"
									raw_text = "#R #bold [DCProjectedWholeLevelInt()]#!"
								}
								text_single = {
									parentanchor = center
									align = center|nobaseline
									fontsize = 12
									fontsize_min = 6
									visible = "[And(GreaterThan_float(DCInvestmentLevel(), '(float)-1'), LessThan_float(DCInvestmentLevel(), '(float)1'))]"
									raw_text = "#high #bold 0#!"
								}
							}
						}
					}
				}

				expand = {  }
			}
		}
	}
}
